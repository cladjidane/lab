---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Fabien Canu · Architecte produit IA · Bretagne"
  description="Développeur en Bretagne. Conseil et architecture IA, formation certifiée Qualiopi, réalisation de produits. Cartographie et données géographiques en spécialité."
>
  <!-- ================= NAV ================= -->
  <nav class="home-nav">
    <div class="home-nav-inner">
      <a href="/" class="home-brand">Fabien Canu</a>
      <div class="home-nav-links">
        <a href="#a-propos" class="home-nav-link home-nav-hide-mobile">À propos</a>
        <a href="/lab" class="home-nav-link">Le lab</a>
        <a href="mailto:contact@koality.fr" class="home-nav-cta">Écrire</a>
      </div>
    </div>
  </nav>

  <main class="home">
    <!-- ================= ARRIVÉE ================= -->
    <section class="home-hero-band">
      <div class="home-hero">
        <div class="home-eyebrow">
          <span class="home-eyebrow-dash"></span>
          <span class="home-eyebrow-txt">Architecte produit IA · Bretagne</span>
        </div>
        <h1 class="home-h1">Fabien<br />Canu<span class="accent">.</span></h1>
        <p class="home-lead">
          Tout le monde produit avec l'IA. Le savoir-faire, c'est autre chose.
        </p>
      </div>
    </section>

    <div class="home-col">

      <!-- ================= LES 3 FAMILLES (colonnes) ================= -->
      <section class="home-fams">
        <div class="home-fams-grid">
          <div class="home-fam-card home-fam-card--cyan grain-paper">
            <span class="material-symbols-outlined home-fam-icon home-fam-icon--cyan">hub</span>
            <h2 class="home-fam-name">Conseil &amp; architecture IA</h2>
            <p class="home-fam-txt">
              J'intègre l'IA dans des produits qui existent déjà. Architecture,
              choix des bons modèles, mise en production. Cartographie et données
              géographiques en spécialité.
            </p>
            <p class="home-fam-tech">Claude, GPT · RAG &amp; embeddings · agents &amp; MCP · MapLibre, PostGIS</p>
          </div>

          <div class="home-fam-card home-fam-card--coral grain-paper">
            <span class="material-symbols-outlined home-fam-icon home-fam-icon--coral">school</span>
            <h2 class="home-fam-name">Formation</h2>
            <p class="home-fam-txt">
              Je forme des équipes et des indépendants à travailler avec l'IA, du
              premier contact jusqu'à l'autonomie.
            </p>
            <p class="home-fam-qualiopi"><span class="check">✓</span> Certifié Qualiopi, les formations sont finançables.</p>
            <p class="home-fam-tech">Claude, ChatGPT · Claude Code · prompt engineering · automatisation</p>
          </div>

          <div class="home-fam-card home-fam-card--amber grain-paper">
            <span class="material-symbols-outlined home-fam-icon home-fam-icon--amber">deployed_code</span>
            <h2 class="home-fam-name">Réalisation</h2>
            <p class="home-fam-txt">
              Je conçois et je livre des produits, du cadrage jusqu'en production.
              Applications web et mobile, cartographie, architectures métier.
            </p>
            <p class="home-fam-tech">Astro, React · TypeScript, Node · PostgreSQL, PostGIS · MapLibre GL · Whisper, TTS</p>
          </div>
        </div>
      </section>

      <hr class="home-rule" />

      <!-- ================= EN PRODUCTION ================= -->
      <section class="home-block home-prod">
        <div class="home-kicker">
          <span class="home-kicker-dash"></span>
          <span class="home-kicker-label">En production</span>
        </div>
        <h2 class="home-h2">Des réalisations récentes.</h2>
        <p class="home-prod-lead">
          Des dizaines d'autres derrière, souvent sous confidentialité.
          <a href="https://koality.fr/realisations" target="_blank" rel="noopener">Le portfolio complet</a>.
        </p>

        <div class="home-prod-grid">
          <!-- Oignon de Roscoff -->
          <article class="home-pcard">
            <div class="home-pmedia">
              <video
                controls
                preload="none"
                playsinline
                poster="/images/oignon-cas-poster.webp"
                width="1280"
                height="810"
              >
                <source src="/videos/oignon-cas.mp4" type="video/mp4" />
                Votre navigateur ne peut pas lire cette vidéo.
              </video>
            </div>
            <div class="home-pbody">
              <div class="home-plabel">AOP · Filière agricole</div>
              <h3 class="home-pname">Oignon de Roscoff</h3>
              <p class="home-pproof">
                Le syndicat avait déjà son outil de gestion. J'y ai greffé un
                assistant IA qui remplit les six déclarations réglementaires à la
                voix, sans toucher au reste. Les données restent chez eux.
                <span class="home-pstat">80 % de temps de saisie en moins.</span>
              </p>
              <a href="/oignon-roscoff-aop" class="home-plink">Voir le détail <span class="accent">→</span></a>
            </div>
          </article>

          <!-- Ma PAI -->
          <article class="home-pcard">
            <div class="home-pmedia">
              <img
                src="/images/pai-graph.gif"
                alt="Le réseau de connaissances de ma PAI qui se construit au fil des sessions"
                width="1280"
                height="800"
                loading="lazy"
              />
            </div>
            <div class="home-pbody">
              <div class="home-plabel">Développement assisté par IA</div>
              <h3 class="home-pname">Ma PAI</h3>
              <p class="home-pproof">
                Mon assistant personnel. Il retient tout d'une session à l'autre :
                les décisions, le contexte des projets, mes façons de bosser. De la
                vraie prod, la mienne : 1500 sessions, 12 000 faits, l'IA à mes
                côtés tous les jours.
              </p>
              <a href="/pai" class="home-plink">Voir le détail <span class="accent">→</span></a>
            </div>
          </article>
        </div>

        <!-- ================= À DÉCOUVRIR DANS LE LAB ================= -->
        <div class="home-lab-strip">
          <div class="home-kicker">
            <span class="home-kicker-dash"></span>
            <span class="home-kicker-label">À découvrir dans le lab</span>
          </div>
          <p class="home-lab-intro">
            À côté du travail client, je construis mes propres outils pour creuser
            l'IA en la manipulant. Chaque fiche détaille l'architecture et les
            partis pris techniques.
          </p>
          <div class="home-lab-row">
            <a href="/jaja" class="home-lab-card">
              <span class="home-lab-dot" style="background:#00b6d8"></span>
              <span class="home-lab-name">Jaja</span>
              <span class="home-lab-hk">Les assistants vocaux répondent aux questions. Jaja exécute des tâches, plusieurs agents dispatchés en parallèle.</span>
            </a>
            <a href="/gitttte" class="home-lab-card">
              <span class="home-lab-dot" style="background:#d9950a"></span>
              <span class="home-lab-name">GITTTTE</span>
              <span class="home-lab-hk">Croiser dix critères sur une carte, commune par commune. La zone qui colle ressort.</span>
            </a>
            <a href="/dictaphone" class="home-lab-card">
              <span class="home-lab-dot" style="background:#ff7e67"></span>
              <span class="home-lab-name">Dictaphone</span>
              <span class="home-lab-hk">Tout ce qui se dit à l'oral, transcrit et retrouvable. En local, rien ne quitte la machine.</span>
            </a>
            <a href="/programme-ton-agent" class="home-lab-card">
              <span class="home-lab-dot" style="background:#1b1c1a"></span>
              <span class="home-lab-name">Programme ton agent</span>
              <span class="home-lab-hk">Un jeu pour comprendre les agents IA. On en compose un, on le lâche, on voit la note.</span>
            </a>
          </div>
          <a href="/lab" class="home-inline-link">Explorer tout le lab <span class="accent">→</span></a>
        </div>
      </section>

      <hr class="home-rule" />

      <!-- ================= QUI JE SUIS ================= -->
      <section id="a-propos" class="home-block">
        <div class="home-kicker">
          <span class="home-kicker-dash"></span>
          <span class="home-kicker-label">Qui je suis</span>
        </div>
        <p class="home-about">
          Je construis des produits depuis bien avant l'IA. Le savoir-faire vient
          de là.
        </p>
        <p class="home-about-line">
          J'anime des rencontres IA en Bretagne, je présente, je participe. Et je
          construis, souvent en coulisse.
        </p>
        <p class="home-about-line">
          Ce qui m'intéresse, c'est l'IA qui tient en production une fois l'effet
          démo passé, dans des métiers réels.
        </p>
        <p class="home-about-koality">
          Basé à Lesneven. Je travaille sous <b>Koality</b>, ma structure,
          certifiée Qualiopi.
        </p>
      </section>
    </div>

    <!-- ================= CONTACT ================= -->
    <section class="home-contact grain-kraft">
      <div class="home-contact-inner">
        <div class="home-contact-eyebrow">Parler</div>
        <p class="home-contact-h">Un projet, une formation, une intervention ? Écrivez-moi.</p>
        <a href="mailto:contact@koality.fr" class="home-contact-mail">contact@koality.fr</a>
        <p class="home-contact-refs">Des <b>références clients à joindre directement</b>, sur demande.</p>
        <p class="home-contact-foot">
          Rester au courant, sans me suivre partout,
          <a href="https://www.linkedin.com/in/fabien-canu/" target="_blank" rel="noopener">LinkedIn</a>.
        </p>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* =================== NAV =================== */
  .home-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(251, 249, 245, 0.82);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(27, 28, 26, 0.07);
    padding: 0 clamp(24px, 8vw, 130px);
  }
  .home-nav-inner {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 0;
  }
  .home-brand {
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: 16px;
    color: #1b1c1a;
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  .home-nav-links {
    display: flex;
    align-items: center;
    gap: 26px;
  }
  .home-nav-link {
    font-family: "Space Grotesk", monospace;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #6e7880;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .home-nav-link:hover {
    color: #ff7e67;
  }
  .home-nav-cta {
    font-family: "Space Grotesk", monospace;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fbf9f5;
    background: #1b1c1a;
    padding: 9px 16px;
    border-radius: 100px;
    text-decoration: none;
    transition: background 0.2s ease;
  }
  .home-nav-cta:hover {
    background: #35322d;
  }

  /* =================== LAYOUT =================== */
  .home {
    background: #fbf9f5;
  }
  .home-col {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 clamp(24px, 5vw, 72px);
  }
  .accent {
    color: #ff7e67;
  }
  .home-rule {
    border: 0;
    height: 1px;
    background: rgba(27, 28, 26, 0.1);
    max-width: 1100px;
    margin: 0;
  }
  .home-italic {
    font-style: italic;
    font-weight: 600;
  }

  /* =================== ARRIVÉE =================== */
  .home-hero-band {
    padding: 0 clamp(24px, 8vw, 130px);
  }
  .home-hero {
    max-width: 1400px;
    margin: 0 auto;
    padding: clamp(64px, 10vw, 104px) 0 clamp(72px, 9vw, 116px);
  }
  .home-eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 34px;
  }
  .home-eyebrow-dash {
    width: 28px;
    height: 3px;
    background: #ff7e67;
    display: inline-block;
  }
  .home-eyebrow-txt {
    font-family: "Space Grotesk", monospace;
    font-size: 12px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #8f918c;
  }
  .home-h1 {
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(3.2rem, 9vw, 88px);
    line-height: 0.9;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: #1b1c1a;
  }
  .home-lead {
    margin-top: 34px;
    font-size: clamp(19px, 2.4vw, 23px);
    line-height: 1.5;
    color: #4a4643;
    max-width: 560px;
    font-weight: 400;
  }

  /* =================== LES 3 FAMILLES (colonnes) =================== */
  .home-fams-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .home-fam-card {
    padding: clamp(32px, 3vw, 44px);
    border-radius: 20px;
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .home-fam-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 26px 54px -32px rgba(27, 28, 26, 0.4);
  }
  .home-fam-card--cyan {
    background-color: #e8fafe;
  }
  .home-fam-card--coral {
    background-color: #fff0ed;
  }
  .home-fam-card--amber {
    background-color: #fff8e1;
  }
  .home-fam-icon {
    font-size: 46px;
    line-height: 1;
    margin-bottom: 22px;
    display: block;
  }
  .home-fam-icon--cyan {
    color: #006386;
  }
  .home-fam-icon--coral {
    color: #e0563c;
  }
  .home-fam-icon--amber {
    color: #c08a00;
  }
  .home-fam-name {
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(24px, 2.4vw, 31px);
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #1b1c1a;
  }
  .home-fam-txt {
    margin-top: 18px;
    font-size: 16.5px;
    line-height: 1.55;
    color: #2a2620;
  }
  .home-fam-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: auto;
    padding-top: 28px;
  }
  .home-fam-pill {
    font-family: "Space Grotesk", sans-serif;
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.005em;
    padding: 5px 10px;
    border-radius: 7px;
    white-space: nowrap;
  }
  .home-fam-card--cyan .home-fam-pill {
    background: rgba(0, 99, 134, 0.09);
    color: #005f80;
  }
  .home-fam-card--coral .home-fam-pill {
    background: rgba(207, 74, 48, 0.1);
    color: #c2452d;
  }
  .home-fam-card--amber .home-fam-pill {
    background: rgba(152, 112, 26, 0.13);
    color: #82600f;
  }

  /* =================== KICKER (label de section) =================== */
  .home-kicker {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 24px;
  }
  .home-kicker-dash {
    width: 24px;
    height: 2px;
    background: #ff7e67;
    display: inline-block;
  }
  .home-kicker-label {
    font-family: "Space Grotesk", monospace;
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #9a968f;
  }

  /* =================== SUR SCÈNE (discret) =================== */
  .home-minor {
    padding: clamp(64px, 8vw, 88px) 0 clamp(56px, 7vw, 72px);
    max-width: 1000px;
  }
  .home-minor-txt {
    font-size: 18px;
    line-height: 1.6;
    color: #4a4643;
    max-width: 720px;
  }

  /* =================== BLOCKS =================== */
  .home-block {
    padding: clamp(80px, 11vw, 116px) 0;
    max-width: 1100px;
  }

  /* =================== UN CAS =================== */
  .home-h2 {
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(40px, 6vw, 52px);
    line-height: 1;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #1b1c1a;
  }
  .home-case-meta {
    margin: 22px 0 32px;
    display: flex;
    gap: 12px;
    align-items: center;
    font-family: "Space Grotesk", monospace;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #8f918c;
  }
  .home-case-meta .sep {
    color: #d3ccc0;
  }
  .home-shot {
    width: 100%;
    max-width: 700px;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgba(27, 28, 26, 0.08);
    box-shadow: 0 30px 60px -40px rgba(27, 28, 26, 0.4);
  }
  .home-shot img,
  .home-shot video {
    display: block;
    width: 100%;
    height: auto;
  }
  .home-shot-cap {
    margin-top: 14px;
    font-family: "Space Grotesk", monospace;
    font-size: 12px;
    letter-spacing: 0.04em;
    color: #9a968f;
  }
  .home-case-grid {
    margin-top: 34px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    max-width: 820px;
  }
  .home-case-key {
    font-family: "Space Grotesk", monospace;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #ff7e67;
    margin-bottom: 12px;
  }
  .home-case-txt {
    font-size: 18px;
    line-height: 1.6;
    color: #4a4643;
  }
  .home-tags-block {
    margin-top: 38px;
    padding-top: 30px;
    border-top: 1px solid rgba(27, 28, 26, 0.1);
    max-width: 820px;
  }
  .home-tags-label {
    font-family: "Space Grotesk", monospace;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #9a968f;
    margin-bottom: 16px;
  }
  .home-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .home-tag {
    border: 1px solid rgba(27, 28, 26, 0.14);
    border-radius: 100px;
    padding: 9px 16px;
    font-size: 15px;
    font-weight: 500;
    color: #1b1c1a;
  }
  .home-tag--hot {
    border-color: #ffd4ca;
    color: #e0563c;
    background: #fff0ed;
    font-weight: 600;
  }
  .home-inline-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 28px;
    font-size: 17px;
    font-weight: 600;
    color: #1b1c1a;
    text-decoration: none;
    border-bottom: 2px solid #ff7e67;
    padding-bottom: 3px;
    transition: color 0.2s ease;
  }
  .home-inline-link:hover {
    color: #ff7e67;
  }

  /* =================== QUI JE SUIS =================== */
  .home-about {
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(21px, 2.8vw, 24px);
    line-height: 1.5;
    font-weight: 500;
    color: #1b1c1a;
    max-width: 680px;
  }
  .home-about b {
    font-weight: 700;
  }

  /* =================== CONTACT =================== */
  .home-contact {
    margin-top: 20px;
    background-color: #1b1c1a;
    padding: clamp(80px, 10vw, 104px) clamp(24px, 8vw, 130px);
  }
  .home-contact-inner {
    max-width: 1400px;
    margin: 0 auto;
  }
  .home-contact-eyebrow {
    font-family: "Space Grotesk", monospace;
    font-size: 12px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #7a756c;
    margin-bottom: 26px;
  }
  .home-contact-h {
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(32px, 5vw, 40px);
    line-height: 1.1;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: #fbf9f5;
    max-width: 560px;
  }
  .home-contact-mail {
    display: inline-block;
    margin-top: 30px;
    font-family: "Space Grotesk", monospace;
    font-size: 22px;
    color: #fbf9f5;
    text-decoration: none;
    border-bottom: 2px solid #ff7e67;
    padding-bottom: 4px;
    transition: color 0.2s ease;
  }
  .home-contact-mail:hover {
    color: #ff7e67;
  }
  .home-contact-foot {
    margin-top: 36px;
    font-size: 16px;
    color: #9a968f;
  }
  .home-contact-foot a {
    color: #c9c4bb;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* =================== RESPONSIVE =================== */
  @media (max-width: 860px) {
    .home-fams-grid {
      grid-template-columns: 1fr;
      gap: 14px;
    }
  }
  @media (max-width: 680px) {
    .home-case-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .home-nav-hide-mobile {
      display: none;
    }
  }

  /* =================== FAMILLES : ligne techno + Qualiopi =================== */
  .home-fam-tech {
    font-family: "Space Grotesk", monospace;
    font-size: 12.5px;
    line-height: 1.6;
    letter-spacing: 0.01em;
    color: #8f918c;
    margin-top: 22px;
  }
  .home-fam-qualiopi {
    font-size: 15.5px;
    line-height: 1.5;
    color: #1b1c1a;
    margin-top: 16px;
  }
  .home-fam-qualiopi .check {
    color: #006386;
    font-weight: 700;
    margin-right: 4px;
  }

  /* =================== EN PRODUCTION (2 colonnes) =================== */
  .home-prod-lead {
    font-size: 16px;
    line-height: 1.55;
    color: #6e7880;
    max-width: 640px;
    margin: 16px 0 0;
  }
  .home-prod-lead a {
    color: #1b1c1a;
    text-decoration: none;
    border-bottom: 1px solid #ff7e67;
    padding-bottom: 1px;
    white-space: nowrap;
  }
