---
import Layout from "../layouts/Layout.astro";
import { personSchema, organizationSchema } from "../lib/schema";
---

<Layout
  title="Fabien Canu · Architecte produit & IA · Bretagne"
  description="Architecte produit & IA en Bretagne. Conseil et architecture, développement d'applications web et mobiles, formation certifiée Qualiopi. 25 ans d'expérience produit."
  schemas={[personSchema, organizationSchema]}
>
  <!-- ================= NAV ================= -->
  <nav class="home-nav">
    <div class="home-nav-inner">
      <a href="/" class="home-brand">Fabien Canu</a>
      <div class="home-nav-links">
        <a href="#a-propos" class="home-nav-link home-nav-hide-mobile">À propos</a>
        <a href="/lab" class="home-nav-link">Le lab</a>
        <a href="mailto:fabien@koality.fr" class="home-nav-cta">Écrire</a>
      </div>
    </div>
  </nav>

  <main class="home">
    <!-- ================= ARRIVÉE ================= -->
    <section class="home-hero-band">
      <div class="home-hero">
        <div class="home-hero-main">
          <div class="home-eyebrow">
            <span class="home-eyebrow-dash"></span>
            <span class="home-eyebrow-txt">Architecte produit &amp; IA · Bretagne</span>
          </div>
          <h1 class="home-h1">Fabien<br />Canu<span class="accent">.</span></h1>
          <p class="home-lead">
            L'IA change les outils. Concevoir les bons produits reste un métier.
          </p>
        </div>
        <aside class="home-hero-card grain-paper">
          <div class="home-cred-row home-cred-row--lead">
            <span class="home-cred-num">25 ans</span>
            <span class="home-cred-txt">d'expérience</span>
          </div>
          <div class="home-cred-row">
            <span class="home-cred-txt">Développement &amp; design de produits numériques, de&nbsp;A&nbsp;à&nbsp;Z</span>
          </div>
          <div class="home-cred-row">
            <span class="home-cred-label">IA générative</span>
            <span class="home-cred-txt">LLM · RAG &amp; embeddings · agents &amp; MCP · SDK custom · orchestration multi-agents · voix &amp; vision</span>
          </div>
          <div class="home-cred-row">
            <span class="home-cred-label">Plateformes</span>
            <span class="home-cred-txt">Web · Mobile · SaaS · API &amp; temps réel · outils métier</span>
          </div>
        </aside>
      </div>
    </section>

    <div class="home-col">

      <!-- ================= LES 3 FAMILLES (colonnes) ================= -->
      <section class="home-fams">
        <div class="home-fams-grid">
          <div class="home-fam-card home-fam-card--cyan grain-paper">
            <span class="material-symbols-outlined home-fam-icon home-fam-icon--cyan">hub</span>
            <h2 class="home-fam-name">Conseil &amp; architecture</h2>
            <p class="home-fam-txt">
              J'accompagne les entreprises dans leurs choix techniques, le cadrage
              de leurs projets numériques et la conception d'architectures robustes.
              Lorsque l'IA apporte une vraie valeur, je l'intègre dès la phase de
              conception.
            </p>
            <p class="home-fam-tech">SDK IA · RAG &amp; embeddings · orchestration d'agents · MCP · architecture logicielle · souveraineté des données</p>
          </div>

          <div class="home-fam-card home-fam-card--amber grain-paper">
            <span class="material-symbols-outlined home-fam-icon home-fam-icon--amber">deployed_code</span>
            <h2 class="home-fam-name">Développement &amp; design</h2>
            <p class="home-fam-txt">
              Je conçois et développe des applications web, mobiles et des outils
              métier sur mesure. J'interviens également en renfort sur des projets
              complexes nécessitant une expertise technique ou architecturale.
            </p>
            <p class="home-fam-tech">React &amp; React Native · Astro, Node · TypeScript, Tailwind · PostgreSQL, PostGIS · MapLibre · Whisper, TTS</p>
          </div>

          <div class="home-fam-card home-fam-card--coral grain-paper">
            <span class="material-symbols-outlined home-fam-icon home-fam-icon--coral">school</span>
            <h2 class="home-fam-name">Formation &amp; transmission</h2>
            <p class="home-fam-txt">
              J'accompagne les dirigeants, les équipes et les étudiants dans leur
              montée en compétences, sur les technologies web comme sur les usages
              concrets de l'IA. J'interviens aussi comme formateur vacataire en
              écoles supérieures et centres de formation.
            </p>
            <p class="home-fam-tech">Claude, ChatGPT · Claude Code · prompt engineering · automatisation · workflows dev IA · pédagogie IA-native</p>
          </div>
        </div>

        <div class="home-fams-note">
          <span class="home-fams-note-tag">Koality Academy</span>
          <span class="home-fams-note-txt">
            Mes formations sont dispensées via Koality Academy, notre organisme
            certifié <strong>Qualiopi</strong>, éligible aux financements OPCO.
          </span>
        </div>
      </section>

      <hr class="home-rule" />

      <!-- ================= EN PRODUCTION ================= -->
      <section class="home-block home-prod">
        <div class="home-kicker">
          <span class="home-kicker-dash"></span>
          <span class="home-kicker-label">En production</span>
        </div>
        <h2 class="home-h2">Quelques réalisations.</h2>
        <p class="home-prod-lead">
          La plupart de mes missions sont couvertes par des accords de
          confidentialité. Voici quelques exemples de projets que je peux partager.
          <a href="https://koality.fr/realisations" target="_blank" rel="noopener">Le portfolio complet</a>.
        </p>

        <div class="home-prod-grid">
          <!-- Oignon de Roscoff -->
          <article class="home-pcard">
            <div class="home-pmedia">
              <video
                controls
                preload="none"
                playsinline
                poster="/images/oignon-cas-poster.webp"
                width="1280"
                height="810"
              >
                <source src="/videos/oignon-cas.mp4" type="video/mp4" />
                Votre navigateur ne peut pas lire cette vidéo.
              </video>
            </div>
            <div class="home-pbody">
              <div class="home-plabel">AOP · Filière agricole</div>
              <h3 class="home-pname">Oignon de Roscoff</h3>
              <p class="home-psub">
                Une plateforme métier qui automatise les déclarations
                réglementaires et réduit de plus de 80 % le temps de saisie.
              </p>
              <p class="home-pproof">
                Le syndicat disposait déjà de son outil de gestion. J'y ai intégré
                un assistant IA qui remplit à la voix les six déclarations
                réglementaires, sans modifier l'application existante. Les données
                restent hébergées chez eux.
              </p>
              <a href="/oignon-roscoff-aop" class="home-plink">Voir le détail <span class="accent">→</span></a>
            </div>
          </article>

          <!-- Ma PAI -->
          <article class="home-pcard">
            <div class="home-pmedia">
              <img
                src="/images/pai-graph.gif"
                alt="Le réseau de connaissances de ma PAI qui se construit au fil des sessions"
                width="1280"
                height="800"
                loading="lazy"
              />
            </div>
            <div class="home-pbody">
              <div class="home-plabel">Développement assisté par IA</div>
              <h3 class="home-pname">Ma PAI</h3>
              <p class="home-psub">
                Un laboratoire personnel où j'expérimente les agents IA, le RAG, la
                mémoire, MCP et les nouveaux usages avant de les intégrer chez mes
                clients.
              </p>
              <p class="home-pproof">
                Mon assistant personnel. Il retient tout d'une session à l'autre :
                les décisions, le contexte des projets et ma façon de travailler. Je
                l'utilise tous les jours : plus de 1 500 sessions, 12 000 faits
                mémorisés et une IA qui m'accompagne au quotidien.
              </p>
              <a href="/pai" class="home-plink">Voir le détail <span class="accent">→</span></a>
            </div>
          </article>
        </div>

        <!-- ================= À DÉCOUVRIR DANS LE LAB ================= -->
        <div class="home-lab-strip">
          <div class="home-kicker">
            <span class="home-kicker-dash"></span>
            <span class="home-kicker-label">À découvrir dans le lab</span>
          </div>
          <p class="home-lab-intro">
            Je consacre une partie de mon temps à expérimenter de nouveaux usages de
            l'IA. Tous les prototypes ne deviennent pas des produits, mais ils
            nourrissent les solutions que je conçois pour mes clients.
          </p>
          <div class="home-lab-row">
            <a href="/jaja" class="home-lab-card">
              <span class="home-lab-dot" style="background:#00b6d8"></span>
              <span class="home-lab-name">Jaja</span>
              <span class="home-lab-hk">Des assistants vocaux capables de collaborer entre eux pour réaliser des tâches complexes.</span>
            </a>
            <a href="/gitttte" class="home-lab-card">
              <span class="home-lab-dot" style="background:#d9950a"></span>
              <span class="home-lab-name">GITTTTE</span>
              <span class="home-lab-hk">Un moteur de recherche cartographique qui combine IA et données géographiques.</span>
            </a>
            <a href="/dictaphone" class="home-lab-card">
              <span class="home-lab-dot" style="background:#ff7e67"></span>
              <span class="home-lab-name">Dictaphone</span>
              <span class="home-lab-hk">Un dictaphone IA qui transcrit, indexe et retrouve les enregistrements, même en local.</span>
            </a>
            <a href="/programme-ton-agent" class="home-lab-card">
              <span class="home-lab-dot" style="background:#1b1c1a"></span>
              <span class="home-lab-name">Programme ton agent</span>
              <span class="home-lab-hk">Un espace d'expérimentation pour apprendre à concevoir et orchestrer des agents IA.</span>
            </a>
          </div>
          <a href="/lab" class="home-inline-link">Explorer tout le lab <span class="accent">→</span></a>
        </div>
      </section>

      <hr class="home-rule" />
    </div>

    <!-- ================= QUI JE SUIS ================= -->
    <section id="a-propos" class="home-about-band">
      <div class="home-about-block">
        <div class="home-about-text">
          <div class="home-kicker">
            <span class="home-kicker-dash"></span>
            <span class="home-kicker-label">Qui je suis</span>
          </div>
          <p class="home-about">
            Je construis des produits depuis bien avant l'IA. Elle a changé mes
            outils, pas ma façon de concevoir un produit.
          </p>
          <p class="home-about-line">
            Je suis aussi (hyper)actif dans l'animation de rencontres autour de l'IA en
            Bretagne, j'interviens en conférences et je partage mes expérimentations.
            Mais l'essentiel de mon temps va à construire des produits pour mes
            clients, avec une forte activité de R&amp;D en parallèle.
          </p>
          <p class="home-about-line">
            Pour moi, la révolution de l'IA demande d'abord de prendre du recul :
            l'aborder non pas comme une technologie de plus, mais comme une rupture
            majeure de l'industrie du numérique.
          </p>
          <p class="home-about-koality">
            Basé en Bretagne, j'interviens partout où un produit mérite d'être bien
            conçu.
          </p>
        </div>
        <div class="home-about-photo">
          <img
            src="/photo-fabien.jpg"
            alt="Fabien Canu"
            width="1300"
            height="804"
            loading="lazy"
          />
        </div>
      </div>
    </section>

    <!-- ================= CONTACT ================= -->
    <section class="home-contact grain-kraft">
      <div class="home-contact-inner">
        <div class="home-contact-eyebrow">Parler</div>
        <p class="home-contact-h">Un projet, un besoin d'expertise ou une formation ? Parlons-en !</p>
        <div class="home-contact-lines">
          <a href="mailto:fabien@koality.fr" class="home-contact-mail">fabien@koality.fr</a>
          <a href="tel:+33648745829" class="home-contact-tel">06 48 74 58 29</a>
        </div>
        <p class="home-contact-cv">
          Pour aller plus loin :
          <a href="/Fabien-Canu-CV-Architecte-Produit-IA.pdf" target="_blank" rel="noopener">mon CV détaillé en PDF</a>.
        </p>
        <p class="home-contact-foot">
          Vous pouvez également me retrouver sur
          <a href="https://www.linkedin.com/in/fabien-canu/" target="_blank" rel="noopener">LinkedIn</a>,
          j'y partage régulièrement mes expérimentations.
        </p>
        <div class="home-contact-labels">
          <span class="home-contact-labels-cap">Reconnu et engagé</span>
          <div class="home-contact-labels-row">
            <a
              href="https://www.francenum.gouv.fr/activateurs/koality"
              target="_blank"
              rel="noopener"
              class="home-label"
              aria-label="Activateur France Num"
            >
              <img
                src="/images/activateur-france-num.jpg"
                alt="Activateur France Num"
                width="400"
                height="364"
                loading="lazy"
              />
            </a>
            <a
              href="https://www.adnouest.org/"
              target="_blank"
              rel="noopener"
              class="home-label"
              aria-label="Membre ADN Ouest"
            >
              <img
                src="/images/adn-ouest.png"
                alt="Membre ADN Ouest"
                width="600"
                height="600"
                loading="lazy"
              />
            </a>
          </div>
        </div>
        <div class="home-contact-legal">
          <a href="/mentions-legales">Mentions légales</a>
          <span class="sep">·</span>
          <a href="/confidentialite">Politique de confidentialité</a>
          <span class="sep">·</span>
          <a href="/cookies">Cookies</a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* =================== NAV =================== */
  .home-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(251, 249, 245, 0.82);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(27, 28, 26, 0.07);
    padding: 0 clamp(24px, 8vw, 130px);
  }
  .home-nav-inner {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 0;
  }
  .home-brand {
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: 16px;
    color: #1b1c1a;
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  .home-nav-links {
    display: flex;
    align-items: center;
    gap: 26px;
  }
  .home-nav-link {
    font-family: "Space Grotesk", monospace;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #6e7880;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .home-nav-link:hover {
    color: #ff7e67;
  }
  .home-nav-cta {
    font-family: "Space Grotesk", monospace;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fbf9f5;
    background: #1b1c1a;
    padding: 9px 16px;
    border-radius: 100px;
    text-decoration: none;
    transition: background 0.2s ease;
  }
  .home-nav-cta:hover {
    background: #35322d;
  }

  /* =================== LAYOUT =================== */
  .home {
    background: #fbf9f5;
  }
  .home-col {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 clamp(24px, 5vw, 72px);
  }
  .accent {
    color: #ff7e67;
  }
  .home-rule {
    border: 0;
    height: 1px;
    background: rgba(27, 28, 26, 0.1);
    max-width: 1100px;
    margin: 0;
  }
  .home-italic {
    font-style: italic;
    font-weight: 600;
  }

  /* =================== ARRIVÉE =================== */
  .home-hero-band {
    padding: 0 clamp(24px, 8vw, 130px);
  }
  .home-hero {
    max-width: 1400px;
    margin: 0 auto;
    padding: clamp(64px, 10vw, 104px) 0 clamp(72px, 9vw, 116px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(36px, 6vw, 88px);
    align-items: end;
  }

  /* -------- Encart credentials (hero) -------- */
  .home-hero-card {
    align-self: end;
    width: 468px;
    max-width: 100%;
    background: #f4f2ec;
    border: 1px solid rgba(27, 28, 26, 0.09);
    border-radius: 18px;
    padding: 26px 28px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .home-cred-row {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .home-cred-row:not(:last-child) {
    padding-bottom: 16px;
    border-bottom: 1px solid rgba(27, 28, 26, 0.08);
  }
  .home-cred-num {
    font-family: "Space Grotesk", sans-serif;
    font-size: 34px;
    line-height: 1;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #1b1c1a;
  }
  .home-cred-label {
    font-family: "Space Grotesk", monospace;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #9a968f;
    margin-bottom: 2px;
  }
  .home-cred-txt {
    font-size: 15.5px;
    line-height: 1.4;
    font-weight: 500;
    color: #2a2620;
  }
  .home-cred-row--lead .home-cred-txt {
    font-size: 14px;
    color: #6e7880;
  }
  .home-eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 34px;
  }
  .home-eyebrow-dash {
    width: 28px;
    height: 3px;
    background: #ff7e67;
    display: inline-block;
  }
  .home-eyebrow-txt {
    font-family: "Space Grotesk", monospace;
    font-size: 12px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #8f918c;
  }
  .home-h1 {
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(3.2rem, 9vw, 88px);
    line-height: 0.9;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: #1b1c1a;
  }
  .home-lead {
    margin-top: 34px;
    font-size: clamp(19px, 2.4vw, 23px);
    line-height: 1.5;
    color: #4a4643;
    max-width: 560px;
    font-weight: 400;
  }

  /* =================== LES 3 FAMILLES (colonnes) =================== */
  .home-fams-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .home-fam-card {
    padding: clamp(32px, 3vw, 44px);
    border-radius: 20px;
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .home-fam-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 26px 54px -32px rgba(27, 28, 26, 0.4);
  }
  .home-fam-card--cyan {
    background-color: #e8fafe;
  }
  .home-fam-card--coral {
    background-color: #fff0ed;
  }
  .home-fam-card--amber {
    background-color: #fff8e1;
  }
  .home-fam-icon {
    font-size: 46px;
    line-height: 1;
    margin-bottom: 22px;
    display: block;
  }
  .home-fam-icon--cyan {
    color: #006386;
  }
  .home-fam-icon--coral {
    color: #e0563c;
  }
  .home-fam-icon--amber {
    color: #c08a00;
  }
  .home-fam-name {
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(24px, 2.4vw, 31px);
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #1b1c1a;
  }
  .home-fam-txt {
    margin-top: 18px;
    font-size: 16.5px;
    line-height: 1.55;
    color: #2a2620;
  }
  .home-fam-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: auto;
    padding-top: 28px;
  }
  .home-fam-pill {
    font-family: "Space Grotesk", sans-serif;
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.005em;
    padding: 5px 10px;
    border-radius: 7px;
    white-space: nowrap;
  }
  .home-fam-card--cyan .home-fam-pill {
    background: rgba(0, 99, 134, 0.09);
    color: #005f80;
  }
  .home-fam-card--coral .home-fam-pill {
    background: rgba(207, 74, 48, 0.1);
    color: #c2452d;
  }
  .home-fam-card--amber .home-fam-pill {
    background: rgba(152, 112, 26, 0.13);
    color: #82600f;
  }

  /* =================== FAMILLES : encart Koality Academy =================== */
  .home-fams-note {
    margin-top: 18px;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px 16px;
    padding: 16px 22px;
    background: #f4f2ec;
    border: 1px solid rgba(27, 28, 26, 0.09);
    border-radius: 14px;
  }
  .home-fams-note-tag {
    font-family: "Space Grotesk", monospace;
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #006386;
    background: rgba(0, 99, 134, 0.09);
    padding: 6px 11px;
    border-radius: 7px;
    white-space: nowrap;
  }
  .home-fams-note-txt {
    font-size: 15px;
    line-height: 1.5;
    color: #4a4643;
    flex: 1;
    min-width: 240px;
  }
  .home-fams-note-txt strong {
    color: #1b1c1a;
    font-weight: 700;
  }

  /* =================== KICKER (label de section) =================== */
  .home-kicker {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 24px;
  }
  .home-kicker-dash {
    width: 24px;
    height: 2px;
    background: #ff7e67;
    display: inline-block;
  }
  .home-kicker-label {
    font-family: "Space Grotesk", monospace;
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #9a968f;
  }

  /* =================== SUR SCÈNE (discret) =================== */
  .home-minor {
    padding: clamp(64px, 8vw, 88px) 0 clamp(56px, 7vw, 72px);
    max-width: 1000px;
  }
  .home-minor-txt {
    font-size: 18px;
    line-height: 1.6;
    color: #4a4643;
    max-width: 720px;
  }

  /* =================== BLOCKS =================== */
  .home-block {
    padding: clamp(80px, 11vw, 116px) 0;
    max-width: 1100px;
  }

