---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Fabien Canu — Architecte produit IA, en Bretagne"
  description="Architecte produit IA, en Bretagne. 25 ans à concevoir et livrer des produits digitaux. Conseil et architecture IA, formation, réalisation. Co-fondateur de Koality."
>
  <!-- ================= NAV ================= -->
  <nav class="home-nav">
    <div class="home-nav-inner">
      <a href="/" class="home-brand">Fabien Canu</a>
      <div class="home-nav-links">
        <a href="#a-propos" class="home-nav-link home-nav-hide-mobile">À propos</a>
        <a href="/lab" class="home-nav-link">Le lab</a>
        <a href="mailto:contact@koality.fr" class="home-nav-cta">Écrire</a>
      </div>
    </div>
  </nav>

  <main class="home">
    <!-- ================= ARRIVÉE ================= -->
    <section class="home-hero-band">
      <div class="home-hero">
        <div class="home-eyebrow">
          <span class="home-eyebrow-dash"></span>
          <span class="home-eyebrow-txt">Architecte produit IA · Bretagne</span>
        </div>
        <h1 class="home-h1">Fabien<br />Canu<span class="accent">.</span></h1>
        <p class="home-lead">
          25 ans à concevoir et livrer des produits digitaux. Aujourd'hui, l'IA
          au quotidien.
        </p>
      </div>
    </section>

    <div class="home-col">

      <!-- ================= LES 3 FAMILLES — colonnes ================= -->
      <section class="home-fams">
        <div class="home-fams-grid">
          <div class="home-fam-card home-fam-card--cyan grain-paper">
            <span class="material-symbols-outlined home-fam-icon home-fam-icon--cyan">hub</span>
            <h2 class="home-fam-name">Conseil &amp; architecture IA</h2>
            <div class="home-fam-words">Architecture · Intégration · Métier</div>
            <p class="home-fam-txt">
              J'intègre l'IA dans des produits qui existent déjà, là où elle fait
              gagner du temps. Architecture, choix des bons modèles, mise en
              production. Cartographie et données géographiques en spécialité.
            </p>
          </div>

          <div class="home-fam-card home-fam-card--coral grain-paper">
            <span class="material-symbols-outlined home-fam-icon home-fam-icon--coral">school</span>
            <h2 class="home-fam-name">Formation</h2>
            <div class="home-fam-words">Équipes · Indépendants · Financé</div>
            <p class="home-fam-txt">
              Je forme des équipes et des indépendants à travailler avec l'IA, pour
              qui veut apprendre plutôt que déléguer. Dans un cadre financé ou non,
              selon les situations.
            </p>
          </div>

          <div class="home-fam-card home-fam-card--amber grain-paper">
            <span class="material-symbols-outlined home-fam-icon home-fam-icon--amber">deployed_code</span>
            <h2 class="home-fam-name">Réalisation</h2>
            <div class="home-fam-words">Web · Mobile · Cartographie</div>
            <p class="home-fam-txt">
              Je conçois et je livre des produits, du cadrage jusqu'en production.
              Applications web et mobile, cartographie, architectures métier.
            </p>
          </div>
        </div>
      </section>

      <!-- ================= SUR SCÈNE — discret ================= -->
      <section class="home-minor">
        <div class="home-kicker">
          <span class="home-kicker-dash"></span>
          <span class="home-kicker-label">Sur scène &amp; dans le réseau</span>
        </div>
        <p class="home-minor-txt">
          On m'invite aussi à en parler : AI Days Bretagne, Context Collective, le
          Kafe IA en Finistère, et la série
          <span class="home-italic">« L'IA pas pour les Nuls… mais presque »</span>.
        </p>
      </section>

      <hr class="home-rule" />

      <!-- ================= UN CAS ================= -->
      <section class="home-block">
        <div class="home-kicker">
          <span class="home-kicker-dash"></span>
          <span class="home-kicker-label">Un cas · AOP · filière agricole</span>
        </div>
        <h2 class="home-h2">Oignon de Roscoff</h2>
        <div class="home-case-meta">
          <span>29 mois de production</span>
          <span class="sep">/</span>
          <span>100 à 150 producteurs</span>
          <span class="sep">/</span>
          <span>27 communes</span>
        </div>

        <div class="home-shot">
          <video
            controls
            preload="none"
            playsinline
            poster="/images/oignon-cas-poster.webp"
            width="1280"
            height="810"
          >
            <source src="/videos/oignon-cas.mp4" type="video/mp4" />
            Votre navigateur ne peut pas lire cette vidéo.
          </video>
        </div>
        <p class="home-shot-cap">
          L'assistant « Oignon » remplit une déclaration, à la voix ou au texte. Démo, 1 min 40.
        </p>

        <div class="home-case-grid">
          <div>
            <div class="home-case-key">Au départ</div>
            <p class="home-case-txt">
              Six déclarations réglementaires sur papier, ressaisies chaque année à
              l'identique par 100 à 150 producteurs répartis sur 27 communes.
            </p>
          </div>
          <div>
            <div class="home-case-key">Ce qui tourne</div>
            <p class="home-case-txt">
              Les six déclarations numérisées : formulaires intelligents, carte
              cadastrale des parcelles, PDF au format officiel. Un assistant IA guide
              la saisie, à la voix ou au texte. 80% de temps administratif en moins.
            </p>
          </div>
        </div>

        <div class="home-tags-block">
          <div class="home-tags-label">Ce qu'il a fallu réunir</div>
          <div class="home-tags">
            <span class="home-tag home-tag--hot">Design</span>
            <span class="home-tag home-tag--hot">Analyse métier</span>
            <span class="home-tag">Cartographie</span>
            <span class="home-tag">Architecture data</span>
            <span class="home-tag home-tag--hot">Assistant IA</span>
            <span class="home-tag">Formulaires intelligents</span>
            <span class="home-tag">Validation AOP</span>
            <span class="home-tag">Déploiement</span>
          </div>
          <a href="/lab" class="home-inline-link">
            Le reste est dans le lab <span class="accent">→</span>
          </a>
        </div>
      </section>

      <hr class="home-rule" />

      <!-- ================= QUI JE SUIS ================= -->
      <section id="a-propos" class="home-block">
        <div class="home-kicker">
          <span class="home-kicker-dash"></span>
          <span class="home-kicker-label">Qui je suis</span>
        </div>
        <p class="home-about">
          J'ai commencé le développement il y a vingt-cinq ans. J'ai basculé vers
          l'IA parce que c'est là que le métier se réécrit en ce moment. Je codirige
          <b>Koality</b>, une agence à Lesneven : je ne travaille pas seul.
        </p>
      </section>
    </div>

    <!-- ================= CONTACT ================= -->
    <section class="home-contact grain-kraft">
      <div class="home-contact-inner">
        <div class="home-contact-eyebrow">Parler</div>
        <p class="home-contact-h">Envie d'en discuter ? Écrivez-moi.</p>
        <a href="mailto:contact@koality.fr" class="home-contact-mail">contact@koality.fr</a>
        <p class="home-contact-foot">
          Rester au courant, sans me suivre partout,
          <a href="https://www.linkedin.com/in/fabien-canu/" target="_blank" rel="noopener">LinkedIn</a>.
        </p>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* =================== NAV =================== */
  .home-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(251, 249, 245, 0.82);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(27, 28, 26, 0.07);
    padding: 0 clamp(24px, 8vw, 130px);
  }
  .home-nav-inner {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 0;
  }
  .home-brand {
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: 16px;
    color: #1b1c1a;
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  .home-nav-links {
    display: flex;
    align-items: center;
    gap: 26px;
  }
  .home-nav-link {
    font-family: "Space Grotesk", monospace;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #6e7880;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .home-nav-link:hover {
    color: #ff7e67;
  }
  .home-nav-cta {
    font-family: "Space Grotesk", monospace;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fbf9f5;
    background: #1b1c1a;
    padding: 9px 16px;
    border-radius: 100px;
    text-decoration: none;
    transition: background 0.2s ease;
  }
  .home-nav-cta:hover {
    background: #35322d;
  }

  /* =================== LAYOUT =================== */
  .home {
    background: #fbf9f5;
  }
  .home-col {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 clamp(24px, 5vw, 72px);
  }
  .accent {
    color: #ff7e67;
  }
  .home-rule {
    border: 0;
    height: 1px;
    background: rgba(27, 28, 26, 0.1);
    max-width: 1100px;
    margin: 0;
  }
  .home-italic {
    font-style: italic;
    font-weight: 600;
  }

  /* =================== ARRIVÉE =================== */
  .home-hero-band {
    padding: 0 clamp(24px, 8vw, 130px);
  }
  .home-hero {
    max-width: 1400px;
    margin: 0 auto;
    padding: clamp(64px, 10vw, 104px) 0 clamp(72px, 9vw, 116px);
  }
  .home-eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 34px;
  }
  .home-eyebrow-dash {
    width: 28px;
    height: 3px;
    background: #ff7e67;
    display: inline-block;
  }
  .home-eyebrow-txt {
    font-family: "Space Grotesk", monospace;
    font-size: 12px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #8f918c;
  }
  .home-h1 {
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(3.2rem, 9vw, 88px);
    line-height: 0.9;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: #1b1c1a;
  }
  .home-lead {
    margin-top: 34px;
    font-size: clamp(19px, 2.4vw, 23px);
    line-height: 1.5;
    color: #4a4643;
    max-width: 560px;
    font-weight: 400;
  }

  /* =================== LES 3 FAMILLES (colonnes) =================== */
  .home-fams-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .home-fam-card {
    padding: clamp(32px, 3vw, 44px);
    border-radius: 20px;
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .home-fam-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 26px 54px -32px rgba(27, 28, 26, 0.4);
  }
  .home-fam-card--cyan {
    background-color: #e8fafe;
  }
  .home-fam-card--coral {
    background-color: #fff0ed;
  }
  .home-fam-card--amber {
    background-color: #fff8e1;
  }
  .home-fam-icon {
    font-size: 46px;
    line-height: 1;
    margin-bottom: 22px;
    display: block;
  }
  .home-fam-icon--cyan {
    color: #006386;
  }
  .home-fam-icon--coral {
    color: #e0563c;
  }
  .home-fam-icon--amber {
    color: #c08a00;
  }
  .home-fam-name {
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(24px, 2.4vw, 31px);
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #1b1c1a;
  }
  .home-fam-words {
    margin-top: 14px;
    font-family: "Space Grotesk", monospace;
    font-size: 11px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: #7f8a86;
  }
  .home-fam-txt {
    margin-top: 20px;
    font-size: 16.5px;
    line-height: 1.55;
    color: #2a2620;
  }

  /* =================== KICKER (label de section) =================== */
  .home-kicker {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 24px;
  }
  .home-kicker-dash {
    width: 24px;
    height: 2px;
    background: #ff7e67;
    display: inline-block;
  }
  .home-kicker-label {
    font-family: "Space Grotesk", monospace;
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #9a968f;
  }

  /* =================== SUR SCÈNE (discret) =================== */
  .home-minor {
    padding: clamp(64px, 8vw, 88px) 0 clamp(56px, 7vw, 72px);
    max-width: 1000px;
  }
  .home-minor-txt {
    font-size: 18px;
    line-height: 1.6;
    color: #4a4643;
    max-width: 720px;
  }

  /* =================== BLOCKS =================== */
  .home-block {
    padding: clamp(80px, 11vw, 116px) 0;
    max-width: 1100px;
  }

  /* =================== UN CAS =================== */
  .home-h2 {
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(40px, 6vw, 52px);
    line-height: 1;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #1b1c1a;
  }
  .home-case-meta {
    margin: 22px 0 32px;
    display: flex;
    gap: 12px;
    align-items: center;
    font-family: "Space Grotesk", monospace;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #8f918c;
  }
  .home-case-meta .sep {
    color: #d3ccc0;
  }
  .home-shot {
    width: 100%;
    max-width: 700px;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgba(27, 28, 26, 0.08);
    box-shadow: 0 30px 60px -40px rgba(27, 28, 26, 0.4);
  }
  .home-shot img,
  .home-shot video {
    display: block;
    width: 100%;
    height: auto;
  }
  .home-shot-cap {
    margin-top: 14px;
    font-family: "Space Grotesk", monospace;
    font-size: 12px;
    letter-spacing: 0.04em;
    color: #9a968f;
  }
  .home-case-grid {
    margin-top: 34px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    max-width: 820px;
  }
  .home-case-key {
    font-family: "Space Grotesk", monospace;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #ff7e67;
    margin-bottom: 12px;
  }
  .home-case-txt {
    font-size: 18px;
    line-height: 1.6;
    color: #4a4643;
  }
  .home-tags-block {
    margin-top: 38px;
    padding-top: 30px;
    border-top: 1px solid rgba(27, 28, 26, 0.1);
    max-width: 820px;
  }
  .home-tags-label {
    font-family: "Space Grotesk", monospace;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #9a968f;
    margin-bottom: 16px;
  }
  .home-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .home-tag {
    border: 1px solid rgba(27, 28, 26, 0.14);
    border-radius: 100px;
    padding: 9px 16px;
    font-size: 15px;
    font-weight: 500;
    color: #1b1c1a;
  }
  .home-tag--hot {
    border-color: #ffd4ca;
    color: #e0563c;
    background: #fff0ed;
    font-weight: 600;
  }
  .home-inline-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 28px;
    font-size: 17px;
    font-weight: 600;
    color: #1b1c1a;
    text-decoration: none;
    border-bottom: 2px solid #ff7e67;
    padding-bottom: 3px;
    transition: color 0.2s ease;
  }
  .home-inline-link:hover {
    color: #ff7e67;
  }

  /* =================== QUI JE SUIS =================== */
  .home-about {
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(21px, 2.8vw, 24px);
    line-height: 1.5;
    font-weight: 500;
    color: #1b1c1a;
    max-width: 680px;
  }
  .home-about b {
    font-weight: 700;
  }

  /* =================== CONTACT =================== */
  .home-contact {
    margin-top: 20px;
    background-color: #1b1c1a;
    padding: clamp(80px, 10vw, 104px) clamp(24px, 8vw, 130px);
  }
  .home-contact-inner {
    max-width: 1400px;
    margin: 0 auto;
  }
  .home-contact-eyebrow {
    font-family: "Space Grotesk", monospace;
    font-size: 12px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #7a756c;
    margin-bottom: 26px;
  }
  .home-contact-h {
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(32px, 5vw, 40px);
    line-height: 1.1;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: #fbf9f5;
    max-width: 560px;
  }
  .home-contact-mail {
    display: inline-block;
    margin-top: 30px;
    font-family: "Space Grotesk", monospace;
    font-size: 22px;
    color: #fbf9f5;
    text-decoration: none;
    border-bottom: 2px solid #ff7e67;
    padding-bottom: 4px;
    transition: color 0.2s ease;
  }
  .home-contact-mail:hover {
    color: #ff7e67;
  }
  .home-contact-foot {
    margin-top: 36px;
    font-size: 16px;
    color: #9a968f;
  }
  .home-contact-foot a {
    color: #c9c4bb;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* =================== RESPONSIVE =================== */
  @media (max-width: 860px) {
    .home-fams-grid {
      grid-template-columns: 1fr;
      gap: 14px;
    }
  }
  @media (max-width: 680px) {
    .home-case-grid {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .home-nav-hide-mobile {
      display: none;
    }
  }
</style>
