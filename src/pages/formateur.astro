---
import Layout from "../layouts/Layout.astro";

// Page de candidature pour les postes de formateur et de vacataire, envoyée avec le CV et la lettre.
// Fabien s'y présente en son nom. Depuis le 7 octobre 2026, la page assume le lien avec Koality :
// adresse Koality et renvoi vers Koality Academy en bas de page, pour la formation en entreprise.
// Non indexée et absente du plan du site : Fabien en envoie le lien lui-même.

// Logos en une seule teinte (Simple Icons), insérés dans la page pour prendre la couleur du texte.
const logoFiles = import.meta.glob<string>("../assets/logos/*.svg", { query: "?raw", import: "default", eager: true });
const logo = (slug: string) => logoFiles[`../assets/logos/${slug}.svg`];

interface Tool {
  name: string;
  // Nom du fichier dans src/assets/logos. Sans logo, l'étiquette affiche seulement le nom.
  slug?: string;
}
interface Track {
  title: string;
  audience: string;
  skills: string;
  // Dit si les participants lisent du code pendant les séances.
  level: string;
  withCode: boolean;
  tools: Tool[];
}

const tracks: Track[] = [
  {
    title: "Assistants et outils IA du quotidien",
    audience: "Adultes en formation : salariés, indépendants, dirigeants, agents de collectivités.",
    skills: "Repérer les tâches où l’outil aide et les cas où il invente une réponse, lui écrire une consigne, vérifier sa réponse avant de s’en servir, automatiser une tâche répétitive.",
    level: "Accessible aux personnes qui découvrent l’IA, sans code",
    withCode: false,
    tools: [
      { name: "Claude", slug: "claude" },
      { name: "ChatGPT", slug: "openai" },
      { name: "Mistral", slug: "mistralai" },
      { name: "Assistant sur mesure" },
      { name: "Routines réutilisables" },
      { name: "Écrire avec l’IA" },
      { name: "Vérifier une réponse" },
      { name: "Images générées" },
      { name: "Dictée et transcription" },
      { name: "Automatisation avec n8n", slug: "n8n" },
      { name: "IA sur ses propres machines", slug: "ollama" },
      { name: "RGPD et AI Act" },
      { name: "Gamma" },
      { name: "Canva", slug: "canva" },
      { name: "Napkin" },
    ],
  },
  {
    title: "Développement web",
    audience: "Étudiants en informatique et en métiers du web, de la première année au master, et adultes en reconversion.",
    skills: "Écrire des pages web, développer une application complète avec sa base de données et ses droits d’utilisateurs, décider de la structure d’une application avant de coder.",
    level: "Les participants écrivent du code",
    withCode: true,
    tools: [
      { name: "HTML", slug: "html5" },
      { name: "CSS", slug: "css" },
      { name: "JavaScript", slug: "javascript" },
      { name: "TypeScript", slug: "typescript" },
      { name: "PHP", slug: "php" },
      { name: "Symfony", slug: "symfony" },
      { name: "WordPress", slug: "wordpress" },
      { name: "React", slug: "react" },
      { name: "Next.js", slug: "nextdotjs" },
      { name: "Node.js", slug: "nodedotjs" },
      { name: "Astro", slug: "astro" },
      { name: "Tailwind", slug: "tailwindcss" },
      { name: "React Native et Expo", slug: "expo" },
      { name: "PostgreSQL", slug: "postgresql" },
      { name: "MySQL", slug: "mysql" },
      { name: "Prisma", slug: "prisma" },
    ],
  },
  {
    title: "IA pour les développeurs",
    audience: "Étudiants en informatique, développeurs et équipes techniques.",
    skills: "Confier une tâche à un agent de code, cadrer son travail, relire et évaluer le code produit. Construire un agent avec ses outils, ses skills et sa mémoire. Appeler un modèle de langage depuis une application et vérifier ses réponses.",
    level: "Les participants lisent du code",
    withCode: true,
    tools: [
      { name: "Claude Code", slug: "claudecode" },
      { name: "Codex", slug: "openai" },
      { name: "GitHub Copilot", slug: "githubcopilot" },
      { name: "Cursor", slug: "cursor" },
      { name: "Windsurf", slug: "windsurf" },
      { name: "Gemini CLI", slug: "googlegemini" },
      { name: "Agents" },
      { name: "Skills" },
      { name: "MCP", slug: "modelcontextprotocol" },
      { name: "RAG" },
      { name: "Embeddings et bases vectorielles" },
      { name: "Mémoire d’agent" },
      { name: "Wiki LLM" },
      { name: "Function calling" },
      { name: "Choix du modèle et coût" },
      { name: "Vercel AI SDK", slug: "vercel" },
      { name: "Ollama", slug: "ollama" },
      { name: "Open WebUI" },
      { name: "Onyx" },
    ],
  },
];

interface School {
  name: string;
  dates: string;
  subject: string;
}
const schoolGroups: { label: string; schools: School[] }[] = [
  {
    label: "Enseignement supérieur",
    schools: [
      { name: "ISEN Brest", dates: "depuis 2017", subject: "PHP, Symfony, React et Next.js en cycle ingénieur" },
      { name: "UBO, Brest", dates: "depuis 2016", subject: "Symfony en DEUST T-MIC" },
      { name: "IUT de Lannion", dates: "depuis 2024", subject: "Architecture des CMS en BUT MMI" },
      { name: "CESI Brest", dates: "2015 à 2017", subject: "Développement full-stack et gestion de projet" },
    ],
  },
  {
    label: "Formation professionnelle",
    schools: [
      { name: "GRETA de Brest", dates: "2023 et 2024", subject: "WordPress et développement web, pour des adultes" },
      { name: "Chez les clients", dates: "depuis vingt ans", subject: "Formation des utilisateurs aux applications développées pour eux" },
    ],
  },
];

// Les quatre façons d'intervenir dans un établissement.
const formats = [
  { title: "Un cours ou quelques séances", text: "Pour compléter un programme existant sur un sujet précis, approfondir un point technique ou apporter un regard de praticien." },
  { title: "Un module complet", text: "Je construis la progression sur plusieurs séances, avec cours, démonstrations, exercices et travaux pratiques." },
  { title: "Un programme existant", text: "Je pars du syllabus, des objectifs pédagogiques et du niveau attendu pour construire les séances et les supports adaptés au groupe." },
  { title: "Un nouveau programme à construire", text: "Nous définissons les objectifs, la progression, les exercices et les livrables. Je propose un format et un volume horaire adaptés au public." },
];

// Programmes de formation IA déjà conçus, repris du CV formateur IA.
const programs = [
  { label: "Premiers usages", items: "Découvrir l’IA générative pour son activité, la littératie IA pour tous les collaborateurs, comprendre un agent IA par le jeu." },
  { label: "Assistants et productivité", items: "Construire son assistant sur mesure, créer des routines réutilisables, écrire avec l’IA sans perdre sa voix, vérifier une réponse." },
  { label: "IA par métier", items: "La fonction commerciale, la communication d’une petite structure, les images générées." },
  { label: "Automatisation", items: "Automatiser sans coder avec n8n, cartographier et digitaliser ses process." },
  { label: "Cadre légal", items: "Cadrer l’IA dans son entreprise, RGPD et AI Act, faire tourner une IA sur ses propres machines." },
];

// Menu du premier écran : un lien par partie de la page.
const sections = [
  { id: "formats", label: "Formats" },
  { id: "sujets", label: "Sujets" },
  { id: "quotidien", label: "IA au quotidien" },
  { id: "ia", label: "IA et code" },
  { id: "pedagogie", label: "Pédagogie" },
  { id: "references", label: "Où j’enseigne" },
  { id: "partage", label: "Hors des cours" },
  { id: "contact", label: "Contact" },
];

const contactMail = "contact@koality.fr";
const contactHref = `mailto:${contactMail}?subject=` + encodeURIComponent("Demande de formation");
---

<Layout
  title="Formation IA et développement web · Fabien Canu, formateur"
  description="Fabien Canu forme aux outils IA du quotidien et enseigne le développement web, en école, à l’université et en formation professionnelle. Dans le Finistère et à distance."
  image="/images/og-formateur.png"
  imageAlt="Fabien Canu, formateur en IA et en développement web"
  siteName="Fabien Canu"
  robots="noindex, nofollow"
>
<div class="profil">

<nav class="pnav">
  <div class="pnav-inner">
    <a href="/" class="pnav-brand">Fabien Canu</a>
    <div class="pnav-links">
      <a href="/lab" class="pnav-link">Le lab</a>
      <a href={contactHref} class="pnav-cta">Écrire</a>
    </div>
  </div>
</nav>

<main>

  <section class="band hero">
    <div class="inner">
      <div class="hero-grid">
        <div class="hero-main">
          <h1>Fabien<br />Canu<span class="accent">.</span></h1>
          <p class="role">Formateur en IA et en développement web</p>
          <div class="read">
            <p class="lead">Je développe des applications depuis vingt-cinq ans et j’enseigne depuis 2015, en école d’ingénieurs, à l’université et en formation professionnelle.</p>
            <p>Je forme aux assistants et aux outils IA du quotidien, et j’enseigne le développement web. Je continue à concevoir et à développer des produits, donc j’enseigne les méthodes et les outils que j’utilise dans mes projets.</p>
          </div>
        </div>

        <div class="offer">
          <ul class="terms">
            <li>En présentiel dans le Finistère, et à distance</li>
            <li>Un cours, quelques séances ou un module complet</li>
            <li>Avec votre programme, ou avec un contenu construit pour vous</li>
          </ul>
          <div class="btns">
            <a class="btn btn--primary" href={contactHref}>Me parler de votre programme</a>
            <a class="btn btn--secondary" href="/Fabien-Canu-CV-formateur.pdf" target="_blank" rel="noopener">Voir mon CV</a>
          </div>
          <p class="next">Envoyez-moi votre programme, le niveau des participants et le volume horaire. Je vous réponds avec une proposition de contenu et de durée.</p>
        </div>
      </div>

      <nav class="jump" aria-label="Sur cette page">
        <p class="jump-label">Sur cette page</p>
        <ul>
          {sections.map((section) => (
            <li><a href={`#${section.id}`}>{section.label}<span aria-hidden="true">↓</span></a></li>
          ))}
        </ul>
      </nav>
    </div>
  </section>

  <section id="formats" class="band formats-band">
    <div class="inner">
      <div class="kicker"><span class="kicker-dash"></span><span class="kicker-label">Formats</span></div>
      <h2>Ce que je peux prendre en charge</h2>
      <p class="intro">Vous avez déjà un programme précis, ou seulement un sujet à couvrir. J’interviens sur une partie du parcours ou je prends en charge un module complet.</p>
      <ol class="formats">
        {formats.map((format) => (
          <li>
            <h3>{format.title}</h3>
            <p>{format.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="sujets" class="band band--low">
    <div class="inner">
      <div class="kicker"><span class="kicker-dash"></span><span class="kicker-label">Interventions</span></div>
      <h2>Les sujets sur lesquels j’interviens</h2>
      <div class="tracks">
        {tracks.map((track) => (
          <article class="track">
            <p class:list={["track-level", { "track-level--open": !track.withCode }]}>{track.level}</p>
            <h3>{track.title}</h3>
            <dl class="track-facts">
              <dt>Public</dt>
              <dd>{track.audience}</dd>
              <dt>Compétences travaillées</dt>
              <dd>{track.skills}</dd>
            </dl>
            <ul class="tools" aria-label={`Outils et technologies : ${track.title}`}>
              {track.tools.map((tool) => (
                <li class="tool">
                  {tool.slug && <span class="tool-logo" aria-hidden="true" set:html={logo(tool.slug)} />}
                  <span>{tool.name}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
      <div class="custom">
        <div class="custom-text">
          <h3>Une formation à la demande</h3>
          <p>Je prépare aussi une formation sur un outil ou un usage précis. Dites-moi l’outil, le public et le temps dont vous disposez.</p>
        </div>
        <a class="btn btn--primary" href={contactHref}>Me parler de votre besoin</a>
      </div>
    </div>
  </section>

  <section id="quotidien" class="band">
    <div class="inner ai">
      <div class="ai-text">
        <div class="kicker"><span class="kicker-dash"></span><span class="kicker-label">Pour tous les métiers</span></div>
        <h2>Former aux outils IA du quotidien</h2>
        <div class="read">
          <p class="lead">Ces formations s’adressent aux salariés, aux indépendants, aux dirigeants et aux agents de collectivités. Elles ne demandent aucune connaissance technique.</p>
          <p>Les séances se déroulent sur les documents et les cas des participants. Chacun apprend à repérer les tâches où l’outil aide, à reconnaître les cas où il invente une réponse, à écrire une consigne et à vérifier le résultat avant de s’en servir.</p>
          <p>Je forme sur l’outil choisi par l’école, le centre de formation ou l’entreprise. Ce peut être par exemple un assistant comme Claude, ChatGPT ou Mistral, ou un outil plus spécialisé comme Gamma ou Canva. La liste reste ouverte : si vous utilisez un autre outil, je prépare la formation dessus.</p>
        </div>
      </div>

      <div class="exercise">
        <h3 class="exercise-title">Des programmes déjà conçus</h3>
        <dl class="programs">
          {programs.map((program) => (
            <div>
              <dt>{program.label}</dt>
              <dd>{program.items}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <section id="ia" class="band band--low">
    <div class="inner ai">
      <div class="ai-text">
        <div class="kicker"><span class="kicker-dash"></span><span class="kicker-label">Pour les développeurs</span></div>
        <h2>Enseigner le développement à l’heure de l’IA</h2>
        <div class="read">
          <p class="lead">Avec l’IA, savoir lire, comprendre, structurer et évaluer le code compte encore plus.</p>
          <p>L’IA sait produire du code rapidement. Un étudiant ou un développeur doit donc comprendre le code produit, repérer les mauvais choix, puis savoir les corriger ou mieux guider l’outil.</p>
          <p>Je construis mes séances dans ce but. Il reste valable quand l’outil ou le modèle change.</p>
        </div>
      </div>

      <div class="exercise">
        <h3 class="exercise-title">Un exercice en trois temps, par exemple</h3>
        <ol class="steps">
          <li>
            <span class="step-n">1</span>
            <div>
              <h4>Construire avec l’IA</h4>
              <p>Le groupe fait construire une petite application par l’IA, fonction après fonction, sans consigne particulière sur son architecture.</p>
            </div>
          </li>
          <li>
            <span class="step-n">2</span>
            <div>
              <h4>Lire le résultat</h4>
              <p>On ouvre le code. On repère les parties répétées, les dépendances inutiles et les endroits où une modification devient difficile.</p>
            </div>
          </li>
          <li>
            <span class="step-n">3</span>
            <div>
              <h4>Recommencer avec une structure choisie</h4>
              <p>Le groupe décide d’une structure, l’écrit dans la consigne et recommence. Il compare ensuite les deux versions et discute des choix obtenus.</p>
            </div>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <section id="pedagogie" class="band">
    <div class="inner teach">
      <div class="teach-text">
        <div class="kicker"><span class="kicker-dash"></span><span class="kicker-label">En cours</span></div>
        <h2>Comment je fais cours</h2>
        <div class="read">
          <p>J’aime partager ce que je sais, et préparer un cours me pousse souvent à approfondir le sujet, à le remettre à plat et à mieux l’expliquer.</p>
          <p>Dans un groupe, les niveaux sont rarement homogènes. J’adapte donc le rythme, les exercices et le niveau d’accompagnement. Je fais travailler les petits groupes à leur rythme, je laisse les plus avancés aller plus loin et j’écris des supports qui peuvent se lire à plusieurs niveaux.</p>
          <p>Le bon format dépend du groupe : son niveau de départ, le temps disponible et les savoir-faire attendus à la fin.</p>
          <p>Je privilégie les séances où l’on produit quelque chose : du code, un prototype, un diagnostic, une comparaison ou un petit projet que l’on peut relire et discuter.</p>
          <p class="signature">Le cours donne à chacun le temps d’apprendre. Mon travail est de le guider.</p>
        </div>
      </div>
      <div class="teach-photo">
        <img src="/photo-fabien.jpg" alt="Fabien Canu devant une salle, pendant une présentation" width="1300" height="804" loading="lazy" />
      </div>
    </div>
  </section>

  <section id="references" class="band band--low">
    <div class="inner">
      <div class="kicker"><span class="kicker-dash"></span><span class="kicker-label">Références</span></div>
      <h2>Où j’enseigne</h2>
      <div class="school-groups">
        {schoolGroups.map((group) => (
          <div class="school-group">
            <h3 class="school-group-label">{group.label}</h3>
            <ul class="school-list">
              {group.schools.map((school) => (
                <li>
                  <span class="school-name">{school.name}</span>
                  <span class="school-dates">{school.dates}</span>
                  <span class="school-subject">{school.subject}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="partage" class="band">
    <div class="inner">
      <div class="kicker"><span class="kicker-dash"></span><span class="kicker-label">Hors des cours</span></div>
      <h2>Partager ce que j’apprends</h2>
      <p class="intro">J’explique aussi l’IA en dehors des cours, à des développeurs comme à des personnes qui la découvrent. Ces projets me servent à tester d’autres formats pédagogiques et à rester au contact des usages.</p>
      <div class="community">
        <article class="community-card">
          <p class="community-tag">Brest · développeurs, ingénieurs, étudiants</p>
          <h3>Context Collective</h3>
          <p>J’ai cofondé cette communauté d’ingénierie IA générative à Brest. Son principe est d’apprendre en public : chacun montre ses essais, y compris les échecs, et repart avec les essais des autres.</p>
          <a class="more" href="https://www.context-collective.org/" target="_blank" rel="noopener">context-collective.org →</a>
        </article>
        <article class="community-card community-card--heart">
          <p class="community-tag">Finistère · personnes qui découvrent l’IA</p>
          <h3>Les Kafé IA</h3>
          <p>J’ai lancé les Kafé IA pour les personnes qui utilisent peu l’IA et qui se posent des questions sur elle. Chaque session part d’un sujet précis, expliqué sans jargon, puis on en discute ensemble. Les Kafé IA font partie des Cafés IA de France Num.</p>
          <a class="more" href="https://kafe-ia.fr/" target="_blank" rel="noopener">kafe-ia.fr →</a>
        </article>
        <article class="community-card">
          <p class="community-tag">En ligne · un jeu pour la formation</p>
          <h3>Programme ton agent</h3>
          <p>J’ai conçu ce jeu pour faire comprendre le fonctionnement d’un agent IA. Le joueur compose son agent carte par carte, le lance sur une demande et voit les conséquences et le coût de chaque choix.</p>
          <a class="more" href="/programme-ton-agent">Voir le projet →</a>
        </article>
      </div>
    </div>
  </section>

  <section id="contact" class="band band--dark">
    <div class="inner contact">
      <div class="eyebrow eyebrow--dark"><span class="eyebrow-dash"></span><span class="eyebrow-txt">Travailler ensemble</span></div>
      <h2 class="ask">Vous cherchez un formateur ou un vacataire&nbsp;?</h2>
      <div class="read read--dark">
        <p>Envoyez-moi votre programme ou le sujet que vous cherchez à couvrir, le niveau des participants et le volume horaire envisagé. Je vous réponds avec une proposition de contenu et de durée.</p>
      </div>
      <div class="btns">
        <a class="btn btn--light" href={contactHref}>Me parler de votre programme</a>
      </div>
      <div class="contact-lines">
        <a class="mail" href={contactHref}>{contactMail}</a>
        <a class="tel" href="tel:+33648745829">06 48 74 58 29</a>
      </div>
      <p class="contact-foot">
        <a href="/Fabien-Canu-CV-formateur.pdf" target="_blank" rel="noopener">CV</a>
        <a href="/lab">Mes projets</a>
        <a href="https://www.linkedin.com/in/fabien-canu/" target="_blank" rel="noopener">LinkedIn</a>
      </p>
      <div class="academy">
        <h3>Pour les entreprises</h3>
        <p>Pour une formation professionnelle en entreprise, mes interventions passent par Koality Academy, mon organisme de formation certifié Qualiopi.</p>
        <a class="academy-link" href="https://academy.koality.fr/" target="_blank" rel="noopener">academy.koality.fr →</a>
      </div>
    </div>
  </section>

</main>

<footer><div class="inner"><a href="/mentions-legales">Mentions légales</a><a href="/confidentialite">Confidentialité</a></div></footer>

</div>
</Layout>

<style>
  /* Mêmes couleurs, polices et blocs que la page /profil */
  .profil {
    --surface: #fbf9f5;
    --low: #f5f3ef;
    --white: #ffffff;
    --ink: #1b1c1a;
    --ink-2: #4a4845;
    --mute: #7d7a74;
    /* Gris des petites étiquettes, assez foncé pour rester lisible sur fond clair */
    --label: #65625c;
    --primary: #006386;
    --coral: #ff7e67;
    --dark-2: #c9c4bb;
    --dark-3: #9a968f;
    --display: "Space Grotesk", "Helvetica Neue", Arial, sans-serif;
    --body: "Manrope", system-ui, -apple-system, "Segoe UI", sans-serif;
  }
  .profil { background: var(--surface); color: var(--ink); font-family: var(--body); font-size: 18px; line-height: 1.65; -webkit-font-smoothing: antialiased; }
  a { color: inherit; }
  img { display: block; max-width: 100%; }

  .band { padding-block: clamp(80px, 11vw, 116px); padding-inline: clamp(24px, 8vw, 130px); }
  .band--low { background: var(--low); }
  .band--dark { background: var(--ink); color: var(--surface); }
  .inner { max-width: 1400px; margin: 0 auto; }
  .read { max-width: 660px; }
  .read p + p { margin-top: 18px; }
  .read p { color: var(--ink-2); }

  h1, h2, h3 { font-family: var(--display); font-weight: 700; letter-spacing: -0.02em; text-wrap: balance; }
  h1 { font-size: clamp(3.2rem, 9vw, 88px); line-height: 0.9; letter-spacing: -0.04em; }
  h2 { font-size: clamp(34px, 5vw, 48px); line-height: 1.04; letter-spacing: -0.03em; margin-bottom: 28px; max-width: 900px; }
  h3 { font-size: clamp(20px, 1.8vw, 24px); line-height: 1.2; }

  /* Hero */
  .hero { padding-top: clamp(56px, 7vw, 88px); padding-bottom: clamp(64px, 8vw, 104px); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: clamp(36px, 6vw, 96px); align-items: end; }
