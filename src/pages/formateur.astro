---
import Layout from "../layouts/Layout.astro";

// Page de candidature pour les postes de formateur IA, envoyée avec le CV et la lettre.
// Les cours de développement ont leur propre page : /formateur/developpement.
// Fabien s'y présente en son nom. Depuis le 7 octobre 2026, la page assume le lien avec Koality :
// adresse Koality et renvoi vers Koality Academy en bas de page, pour la formation en entreprise.
// Non indexée et absente du plan du site : Fabien en envoie le lien lui-même.

// Logos en une seule teinte (Simple Icons), insérés dans la page pour prendre la couleur du texte.
const logoFiles = import.meta.glob<string>("../assets/logos/*.svg", { query: "?raw", import: "default", eager: true });
const logo = (slug: string) => logoFiles[`../assets/logos/${slug}.svg`];

interface Tool {
  name: string;
  // Nom du fichier dans src/assets/logos. Sans logo, l'étiquette affiche seulement le nom.
  slug?: string;
}
interface Track {
  title: string;
  audience: string;
  skills: string;
  // Dit si les participants lisent du code pendant les séances.
  level: string;
  withCode: boolean;
  // Teinte de la carte et icône Material Symbols, reprises des cartes de la page d'accueil.
  tint: "coral" | "amber" | "cyan";
  icon: string;
  tools: Tool[];
}

const tracks: Track[] = [
  {
    title: "Assistants et outils IA du quotidien",
    tint: "coral",
    icon: "auto_awesome",
    audience: "Adultes en formation : salariés, indépendants, dirigeants, agents de collectivités.",
    skills: "Repérer les tâches où l’outil aide et les cas où il invente une réponse, lui écrire une consigne, vérifier sa réponse avant de s’en servir, automatiser une tâche répétitive.",
    level: "Accessible aux personnes qui découvrent l’IA, sans code",
    withCode: false,
    tools: [
      { name: "Claude", slug: "claude" },
      { name: "ChatGPT", slug: "openai" },
      { name: "Mistral", slug: "mistralai" },
      { name: "Assistant sur mesure" },
      { name: "Routines réutilisables" },
      { name: "Écrire avec l’IA" },
      { name: "Vérifier une réponse" },
      { name: "Images générées" },
      { name: "Dictée et transcription" },
      { name: "Automatisation avec n8n", slug: "n8n" },
      { name: "IA sur ses propres machines", slug: "ollama" },
      { name: "RGPD et AI Act" },
      { name: "Gamma" },
      { name: "Canva", slug: "canva" },
      { name: "Napkin" },
    ],
  },
  {
    title: "IA pour les développeurs",
    tint: "cyan",
    icon: "smart_toy",
    audience: "Étudiants en informatique, développeurs et équipes techniques.",
    skills: "Confier une tâche à un agent de code, cadrer son travail, relire et évaluer le code produit. Construire un agent avec ses outils, ses skills et sa mémoire. Appeler un modèle de langage depuis une application et vérifier ses réponses.",
    level: "Les participants lisent du code",
    withCode: true,
    tools: [
      { name: "Claude Code", slug: "claudecode" },
      { name: "Codex", slug: "openai" },
      { name: "GitHub Copilot", slug: "githubcopilot" },
      { name: "Cursor", slug: "cursor" },
      { name: "Windsurf", slug: "windsurf" },
      { name: "Gemini CLI", slug: "googlegemini" },
      { name: "Agents" },
      { name: "Skills" },
      { name: "MCP", slug: "modelcontextprotocol" },
      { name: "RAG" },
      { name: "Embeddings et bases vectorielles" },
      { name: "Mémoire d’agent" },
      { name: "Wiki LLM" },
      { name: "Function calling" },
      { name: "Choix du modèle et coût" },
      { name: "Vercel AI SDK", slug: "vercel" },
      { name: "Ollama", slug: "ollama" },
      { name: "Open WebUI" },
      { name: "Onyx" },
    ],
  },
  {
    title: "Développement web",
    tint: "amber",
    icon: "code",
    audience: "Étudiants en informatique et en métiers du web, de la première année au master. Adultes en reconversion.",
    skills: "Écrire des pages web, développer une application complète avec sa base de données et ses droits d’utilisateurs, décider de la structure d’une application avant de coder.",
    level: "Les participants écrivent du code",
    withCode: true,
    tools: [
      { name: "HTML", slug: "html5" },
      { name: "CSS", slug: "css" },
      { name: "JavaScript", slug: "javascript" },
      { name: "TypeScript", slug: "typescript" },
      { name: "PHP", slug: "php" },
      { name: "Symfony", slug: "symfony" },
      { name: "WordPress", slug: "wordpress" },
      { name: "React", slug: "react" },
      { name: "Next.js", slug: "nextdotjs" },
      { name: "Node.js", slug: "nodedotjs" },
      { name: "Astro", slug: "astro" },
      { name: "Tailwind", slug: "tailwindcss" },
      { name: "React Native et Expo", slug: "expo" },
      { name: "PostgreSQL", slug: "postgresql" },
      { name: "MySQL", slug: "mysql" },
      { name: "Prisma", slug: "prisma" },
    ],
  },
];

interface School {
  name: string;
  dates: string;
  subject: string;
}
const schoolGroups: { label: string; schools: School[] }[] = [
  {
    label: "Formations et interventions IA",
    schools: [
      { name: "Freelances et PME", dates: "depuis 2024", subject: "Formations à l’IA générative, sur les documents et les cas des stagiaires" },
      { name: "Ateliers « De l’idée au produit »", dates: "juillet 2026", subject: "Construire une application avec un agent de code, en groupes de huit" },
      { name: "Conférences", dates: "", subject: "AI Days, Finist’AI Club, BrestJS, Salon Tourisme & Numérique" },
    ],
  },
  {
    label: "Enseignement supérieur",
    schools: [
      { name: "ISEN Brest", dates: "depuis 2017", subject: "PHP, Symfony, React et Next.js en cycle ingénieur" },
      { name: "UBO, Brest", dates: "depuis 2016", subject: "Symfony en DEUST T-MIC" },
      { name: "IUT de Lannion", dates: "depuis 2024", subject: "Architecture des CMS en BUT MMI" },
      { name: "CESI Brest", dates: "2015 à 2017", subject: "Développement full-stack et gestion de projet" },
    ],
  },
  {
    label: "Formation professionnelle",
    schools: [
      { name: "GRETA de Brest", dates: "2023 et 2024", subject: "WordPress et développement web, pour des adultes" },
      { name: "Chez les clients", dates: "depuis vingt ans", subject: "Formation des utilisateurs aux applications développées pour eux" },
    ],
  },
];

// Les quatre façons d'intervenir dans un établissement.
const formats = [
  { icon: "event", title: "Un cours ou quelques séances", text: "Pour compléter un programme existant sur un sujet précis, approfondir un point technique ou apporter un regard de praticien." },
  { icon: "stacks", title: "Un module complet", text: "Je construis la progression sur plusieurs séances, avec cours, démonstrations, exercices et travaux pratiques." },
  { icon: "description", title: "Un programme existant", text: "Je pars du syllabus, des objectifs pédagogiques et du niveau attendu pour construire les séances et les supports adaptés au groupe." },
  { icon: "edit_note", title: "Un nouveau programme à construire", text: "Nous définissons les objectifs, la progression, les exercices et les livrables. Je propose un format et un volume horaire adaptés au public." },
];

// Programmes de formation IA déjà conçus, repris du CV formateur IA.
const programs = [
  { label: "Premiers usages", items: "Découvrir l’IA générative pour son activité, la littératie IA pour tous les collaborateurs, comprendre un agent IA par le jeu." },
  { label: "Assistants et productivité", items: "Construire son assistant sur mesure, créer des routines réutilisables, écrire avec l’IA sans perdre sa voix, vérifier une réponse." },
  { label: "IA par métier", items: "La fonction commerciale, la communication d’une petite structure, les images générées." },
  { label: "Automatisation", items: "Automatiser sans coder avec n8n, cartographier et digitaliser ses process." },
  { label: "Cadre légal", items: "Cadrer l’IA dans son entreprise, RGPD et AI Act, faire tourner une IA sur ses propres machines." },
];

// Menu du premier écran : un lien par partie de la page.
const sections = [
  { id: "formats", label: "Formats" },
  { id: "sujets", label: "Sujets" },
  { id: "quotidien", label: "Déroulement" },
  { id: "pedagogie", label: "Pédagogie" },
  { id: "references", label: "Où j’enseigne" },
  { id: "partage", label: "Hors des cours" },
  { id: "contact", label: "Contact" },
];

const contactMail = "fabien@koality.fr";
const contactHref = `mailto:${contactMail}?subject=` + encodeURIComponent("Demande de formation");
---

<Layout
  title="Formation IA · Fabien Canu, formateur dans le Finistère"
  description="Fabien Canu forme aux assistants et aux outils IA du quotidien, en école, à l’université et en formation professionnelle. Basé dans le Finistère, sur site et à distance."
  image="/images/og-formateur.png"
  imageAlt="Fabien Canu, formateur en IA"
  siteName="Fabien Canu"
  robots="noindex, nofollow"
>
<div class="profil">

<nav class="pnav">
  <div class="pnav-inner">
    <a href="/" class="pnav-brand">Fabien Canu</a>
    <div class="pnav-links">
      <a href="/lab" class="pnav-link">Le lab</a>
      <a href={contactHref} class="pnav-cta">Écrire</a>
    </div>
  </div>
</nav>

<main>

  <section class="band hero">
    <div class="inner">
      <div class="hero-grid">
        <div class="hero-main">
          <h1>Fabien<br />Canu<span class="accent">.</span></h1>
          <p class="role">Formateur en IA</p>
          <div class="read">
            <p class="lead">Je forme aux assistants et aux outils IA du quotidien. J’enseigne depuis 2015, en école d’ingénieurs, à l’université et en formation professionnelle.</p>
            <p>Je conçois et développe des produits numériques depuis vingt-cinq ans. Je forme sur les outils que j’utilise dans mes projets.</p>
          </div>
        </div>

        <div class="offer grain-paper">
          <ul class="terms">
            <li>Basé dans le Finistère · sur site selon le lieu et à distance</li>
            <li>Un cours, quelques séances ou un module complet</li>
            <li>Avec votre programme ou avec un contenu construit pour vous</li>
          </ul>
          <div class="btns">
            <a class="btn btn--primary" href={contactHref}>Me parler de votre programme</a>
            <a class="btn btn--secondary" href="/Fabien-Canu-CV-formateur.pdf" target="_blank" rel="noopener">Voir mon CV</a>
          </div>
          <p class="next">Envoyez-moi votre programme, le niveau des participants et le volume horaire. Je vous réponds avec une proposition de contenu et de durée.</p>
        </div>
      </div>

      <nav class="jump" aria-label="Sur cette page">
        <p class="jump-label">Sur cette page</p>
        <ul>
          {sections.map((section) => (
            <li><a href={`#${section.id}`}>{section.label}<span aria-hidden="true">↓</span></a></li>
          ))}
        </ul>
      </nav>
    </div>
  </section>

  <section id="formats" class="band formats-band">
    <div class="inner">
      <div class="kicker"><span class="kicker-dash"></span><span class="kicker-label">Formats</span></div>
      <h2>Ce que je peux prendre en charge</h2>
      <p class="intro">Vous avez déjà un programme précis ou seulement un sujet à couvrir. J’interviens sur une partie du parcours ou je prends en charge un module complet.</p>
      <ol class="formats">
        {formats.map((format) => (
          <li>
            <span class="material-symbols-outlined format-icon" aria-hidden="true">{format.icon}</span>
            <h3>{format.title}</h3>
            <p>{format.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="sujets" class="band band--low">
    <div class="inner">
      <div class="kicker"><span class="kicker-dash"></span><span class="kicker-label">Interventions</span></div>
      <h2>Les sujets sur lesquels j’interviens</h2>
      <div class="tracks">
        {tracks.map((track) => (
          <article class:list={["track", `track--${track.tint}`, "grain-paper"]}>
            <span class="material-symbols-outlined track-icon" aria-hidden="true">{track.icon}</span>
            <h3>{track.title}</h3>
            <p class="track-level">{track.level}</p>
            <dl class="track-facts">
              <dt>Public</dt>
              <dd>{track.audience}</dd>
              <dt>Compétences travaillées</dt>
              <dd>{track.skills}</dd>
            </dl>
            <ul class="tools" aria-label={`Outils et technologies : ${track.title}`}>
              {track.tools.map((tool) => (
                <li class="tool">
                  {tool.slug && <span class="tool-logo" aria-hidden="true" set:html={logo(tool.slug)} />}
                  <span>{tool.name}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>

      <div class="custom grain-paper">
        <div class="custom-text">
          <h3>Une formation à la demande</h3>
          <p>Je prépare aussi une formation sur un outil ou un usage précis. Dites-moi l’outil, le public et le temps dont vous disposez.</p>
        </div>
        <a class="btn btn--primary" href={contactHref}>Me parler de votre besoin</a>
      </div>
    </div>
  </section>

  <section id="quotidien" class="band">
    <div class="inner ai">
      <div class="ai-text">
        <div class="kicker"><span class="kicker-dash"></span><span class="kicker-label">Pour tous les métiers</span></div>
        <h2>Former aux outils IA du quotidien</h2>
        <div class="read">
          <p class="lead">Ces formations s’adressent aux salariés, aux indépendants, aux dirigeants et aux agents de collectivités. Elles ne demandent aucune connaissance technique.</p>
          <p>Les séances se déroulent sur les documents et les cas des participants. Chacun apprend à repérer les tâches où l’outil aide, à reconnaître les cas où il invente une réponse, à écrire une consigne et à vérifier le résultat avant de s’en servir.</p>
          <p>Je forme sur l’outil choisi par l’école, le centre de formation ou l’entreprise. Ce peut être par exemple un assistant comme Claude, ChatGPT ou Mistral. Ce peut être aussi un outil plus spécialisé comme Gamma ou Canva. La liste reste ouverte : si vous utilisez un autre outil, je prépare la formation dessus.</p>
        </div>
      </div>

      <div class="exercise grain-paper">
        <h3 class="exercise-title">Des programmes déjà conçus</h3>
        <dl class="programs">
          {programs.map((program) => (
            <div>
              <dt>{program.label}</dt>
              <dd>{program.items}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <section id="pedagogie" class="band band--low">
    <div class="inner teach">
      <div class="teach-text">
        <div class="kicker"><span class="kicker-dash"></span><span class="kicker-label">En cours</span></div>
        <h2>Comment je fais cours</h2>
        <div class="read">
          <p>J’aime partager ce que je sais. Préparer un cours me pousse souvent à approfondir le sujet, à le remettre à plat et à mieux l’expliquer.</p>
          <p>Dans un groupe, les niveaux sont rarement homogènes. J’adapte donc le rythme, les exercices et le niveau d’accompagnement. Je fais travailler les petits groupes à leur rythme, je laisse les plus avancés aller plus loin et j’écris des supports qui peuvent se lire à plusieurs niveaux.</p>
          <p>Le bon format dépend du groupe : son niveau de départ, le temps disponible et les savoir-faire attendus à la fin.</p>
          <p>Je privilégie les séances où l’on produit quelque chose : un prototype, un diagnostic, une comparaison ou un petit projet que l’on peut relire et discuter.</p>
          <p class="signature">Le cours donne à chacun le temps d’apprendre. Mon travail est de le guider.</p>
        </div>
      </div>
      <div class="teach-photo">
        <img src="/photo-fabien.jpg" alt="Fabien Canu devant une salle, pendant une présentation" width="1300" height="804" loading="lazy" />
      </div>
    </div>

    <div class="inner backstage-wrap">
      <details class="backstage">
        <summary class="backstage-card grain-paper">
          <span class="backstage-thumbs" aria-hidden="true">
            <img src="/images/programme-ton-agent-build.webp" alt="" width="1440" height="752" loading="lazy" />
            <img src="/images/formateur-comprehension-code-thumb.jpg" alt="" width="640" height="414" loading="lazy" />
            <img src="/images/formateur-ardoise-montage.jpg" alt="" width="1600" height="1000" loading="lazy" />
          </span>
          <span class="backstage-label">
            <span class="backstage-kicker">Les coulisses</span>
            <span class="backstage-title">Comment je prépare mes formations</span>
            <span class="backstage-hint">Des jeux, une réflexion sur la pédagogie et mes propres outils.</span>
          </span>
          <span class="backstage-toggle">
            <span class="backstage-open">Ouvrir</span>
            <span class="backstage-close">Refermer</span>
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </span>
        </summary>

        <div class="backstage-body">
          <article class="case grain-paper">
            <p class="case-method">Apprendre par le jeu</p>
            <p class="case-text">Je développe des outils pédagogiques dédiés à mes formations, et notamment des jeux. Les participants y prennent des décisions et voient leurs effets, sans aucun risque.</p>
            <a class="case-visual" href="https://programme-ton-agent.vercel.app" target="_blank" rel="noopener" aria-label="Jouer à Programme ton agent">
              <img src="/images/programme-ton-agent-build.webp" alt="Écran du jeu Programme ton agent : le joueur branche des outils sur son agent" width="1440" height="752" loading="lazy" />
            </a>
            <p class="case-example"><span>Un exemple</span>Programme ton agent</p>
            <p class="case-text">Le joueur compose un agent IA carte par carte, le lance sur une demande et voit les conséquences et le coût de chaque choix.</p>
            <p class="case-links">
              <a class="more" href="https://programme-ton-agent.vercel.app" target="_blank" rel="noopener">Jouer →</a>
              <a class="more" href="/programme-ton-agent">Voir le projet →</a>
            </p>
            <p class="case-text">J’ai conçu d’autres jeux sur le même principe, comme <a href="/epicycle-draw">Epicycle Draw</a> pour les séries de Fourier. Quand une notion résiste, je fabrique le jeu qui la fait comprendre.</p>
          </article>

          <article class="case grain-paper">
            <p class="case-method">Une réflexion derrière chaque formation</p>
            <p class="case-text">Chaque formation part d’une réflexion sur la façon d’apprendre. Je lis la recherche en pédagogie, j’en tire des principes et je les écris pour les reprendre d’un cours à l’autre.</p>
            <div class="case-visual">
              <img src="/images/formateur-comprehension-code.gif" alt="Un projet d’étudiants expliqué étape par étape : la carte du projet, puis chaque étape ouvre le fichier concerné" width="1280" height="828" loading="lazy" />
            </div>
            <p class="case-example"><span>Un exemple</span>Enseigner quand l’IA fait le travail</p>
            <p class="case-text">Pour bâtir un programme, je pose la même question à chaque notion : si une IA réalisait parfaitement cette tâche, est-ce que je l’enseignerais quand même ? Je garde les notions qui passent ce tri. Je demande ensuite aux étudiants d’expliquer leur rendu, et je note cette explication.</p>
            <p class="case-text">L’animation montre l’outil que j’ai construit pour ça. Il explique un projet étape par étape, et chaque étape ouvre le fichier de code concerné.</p>
            <p class="case-text">J’utilise aussi des approches plus classiques, comme l’atelier AAA : acculturation, arbitrage, action.</p>
          </article>

          <article class="case grain-paper">
            <p class="case-method">Mes propres outils</p>
            <p class="case-text">Je développe mes propres outils pour préparer mes cours et produire mes supports.</p>
            <div class="case-visual">
              <img src="/images/formateur-ardoise-montage.jpg" alt="Écran de montage : l’aperçu de la vidéo, les réglages du clip et la ligne des mots prononcés" width="1600" height="1000" loading="lazy" />
            </div>
            <p class="case-example"><span>Un exemple</span>Mon générateur de vidéos</p>
            <p class="case-text">Il conduit une vidéo de cours du sujet au film. Chaque animation démarre sur un mot prononcé, et je règle le film dans cet écran. La vidéo montrée vient d’un cours sur Next.js.</p>
            <p class="case-example"><span>Un autre outil</span>Mon assistant de création de cours</p>
            <p class="case-text">À partir du programme d’une formation, il prépare les supports et les activités interactives H5P, prêtes à déposer dans Moodle.</p>
          </article>
        </div>
      </details>
    </div>
  </section>

  <section id="references" class="band">
    <div class="inner">
      <div class="kicker"><span class="kicker-dash"></span><span class="kicker-label">Références</span></div>
      <h2>Où j’enseigne et où je forme</h2>
      <div class="school-groups">
        {schoolGroups.map((group) => (
          <div class="school-group">
            <h3 class="school-group-label">{group.label}</h3>
            <ul class="school-list">
              {group.schools.map((school) => (
                <li>
                  <span class="school-name">{school.name}</span>
                  <span class="school-dates">{school.dates}</span>
                  <span class="school-subject">{school.subject}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="partage" class="band band--low">
    <div class="inner">
      <div class="kicker"><span class="kicker-dash"></span><span class="kicker-label">Hors des cours</span></div>
      <h2>Partager ce que j’apprends</h2>
      <p class="intro">J’explique aussi l’IA en dehors des cours, à des développeurs comme à des personnes qui la découvrent. Ces projets me servent à tester d’autres formats pédagogiques et à rester au contact des usages.</p>
      <div class="community">
        <article class="community-card grain-paper">
          <p class="community-tag">Brest · développeurs, ingénieurs, étudiants</p>
          <h3>Context Collective</h3>
          <p>J’ai cofondé cette communauté d’ingénierie IA générative à Brest. Son principe est d’apprendre en public : chacun montre ses essais, y compris les échecs. Chacun repart avec les essais des autres.</p>
          <a class="more" href="https://www.context-collective.org/" target="_blank" rel="noopener">context-collective.org →</a>
        </article>
        <article class="community-card community-card--heart grain-paper">
          <p class="community-tag">Finistère · personnes qui découvrent l’IA</p>
          <h3>Les Kafé IA</h3>
          <p>J’ai lancé les Kafé IA pour les personnes qui utilisent peu l’IA et qui se posent des questions sur elle. Chaque session part d’un sujet précis, expliqué sans jargon. On en discute ensuite ensemble. Les Kafé IA font partie des Cafés IA de France Num.</p>
          <a class="more" href="https://kafe-ia.fr/" target="_blank" rel="noopener">kafe-ia.fr →</a>
        </article>
      </div>
    </div>
  </section>

  <section id="contact" class="band band--dark">
    <div class="inner contact">
      <div class="eyebrow eyebrow--dark"><span class="eyebrow-dash"></span><span class="eyebrow-txt">Travailler ensemble</span></div>
