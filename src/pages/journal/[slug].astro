---
import { render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import SiteNav from "../../components/SiteNav.astro";
import Newsletter from "../../components/Newsletter.astro";
import { projects } from "../../data/projects";
import {
  getArticles,
  formatDate,
  isoDate,
  readingTime,
  articleSchema,
  articleBreadcrumb,
  type Article,
} from "../../lib/journal";

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article, index) => ({
    params: { slug: article.id },
    props: {
      article,
      precedent: articles[index + 1] ?? null,
      suivant: articles[index - 1] ?? null,
    },
  }));
}

interface Props {
  article: Article;
  precedent: Article | null;
  suivant: Article | null;
}

const { article, precedent, suivant } = Astro.props;
const { Content } = await render(article);

const projet = article.data.project
  ? projects.find((p) => p.slug === article.data.project)
  : undefined;
---

<Layout
  title={`${article.data.title} · Journal · Fabien Canu`}
  description={article.data.description}
  type="article"
  image={article.data.cover ?? "/images/og-image.png"}
  schemas={[articleSchema(article), articleBreadcrumb(article)]}
>
  <SiteNav current="journal" />

  <main class="art">
    <div class="art-col">
      <a href="/journal" class="art-back">← Tous les articles</a>

      <header class="art-head">
        <div class="art-meta">
          <time datetime={isoDate(article.data.date)}>{formatDate(article.data.date)}</time>
          <span class="sep">·</span>
          <span>{readingTime(article.body)} min de lecture</span>
          {article.data.draft && <span class="art-draft">Brouillon</span>}
        </div>
        <h1 class="art-h1">{article.data.title}</h1>
        <p class="art-desc">{article.data.description}</p>
        {article.data.tags.length > 0 && (
          <div class="art-tags">
            {article.data.tags.map((tag) => (
              <span class="art-tag">{tag}</span>
            ))}
          </div>
        )}
      </header>

      {article.data.cover && (
        <figure class="art-cover">
          <img
            src={article.data.cover}
            alt={article.data.coverAlt ?? article.data.title}
            loading="eager"
          />
        </figure>
      )}

      <div class="art-body">
        <Content />
      </div>

      {projet && (
        <a href={`/${projet.slug}`} class="art-projet">
          <span class="art-projet-label">Le projet dont parle cet article</span>
          <span class="art-projet-name">{projet.name} <span class="accent">→</span></span>
          <span class="art-projet-desc">{projet.descriptionFr}</span>
        </a>
      )}

      <div class="art-nl">
        <Newsletter compact />
      </div>

      {(precedent || suivant) && (
        <nav class="art-around">
          {precedent ? (
            <a href={`/journal/${precedent.id}`} class="art-around-link">
              <span class="art-around-cap">Article précédent</span>
              <span class="art-around-title">{precedent.data.title}</span>
            </a>
          ) : (
            <span></span>
          )}
          {suivant && (
            <a href={`/journal/${suivant.id}`} class="art-around-link art-around-link--next">
              <span class="art-around-cap">Article suivant</span>
              <span class="art-around-title">{suivant.data.title}</span>
            </a>
          )}
        </nav>
      )}
    </div>
  </main>
</Layout>

<style>
  .art {
    background: #fbf9f5;
    min-height: 70vh;
  }
  .art-col {
    max-width: 760px;
    margin: 0 auto;
    padding: clamp(40px, 6vw, 72px) clamp(24px, 5vw, 40px) clamp(72px, 9vw, 112px);
  }
  .accent {
    color: #ff7e67;
  }

  .art-back {
    font-family: "Space Grotesk", monospace;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #8f918c;
    text-decoration: none;
  }
  .art-back:hover {
    color: #ff7e67;
  }

  .art-head {
    margin-top: 30px;
  }
  .art-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    font-family: "Space Grotesk", monospace;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #9a968f;
  }
  .art-meta .sep {
    color: #d3ccc0;
  }
  .art-draft {
    background: #fff0ed;
    border: 1px dashed #e0563c;
    border-radius: 5px;
    padding: 2px 8px;
    color: #c2452d;
  }
  .art-h1 {
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(34px, 5.6vw, 50px);
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #1b1c1a;
    margin: 18px 0 0;
  }
  .art-desc {
    font-size: 19px;
    line-height: 1.6;
    color: #6e7880;
    margin: 18px 0 0;
  }
  .art-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 22px;
  }
  .art-tag {
    border: 1px solid rgba(27, 28, 26, 0.14);
    border-radius: 100px;
    padding: 5px 13px;
    font-size: 13px;
    color: #4a4643;
  }

  .art-cover {
    margin: clamp(32px, 4vw, 44px) 0 0;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid rgba(27, 28, 26, 0.08);
  }
  .art-cover img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* =================== CORPS DE L'ARTICLE =================== */
  .art-body {
    margin-top: clamp(36px, 5vw, 52px);
  }
  .art-body :global(p) {
    font-size: 17.5px;
    line-height: 1.7;
    color: #4a4643;
    margin: 0 0 20px;
  }
  .art-body :global(p:first-child) {
    font-size: 20px;
    line-height: 1.6;
    color: #1b1c1a;
  }
  .art-body :global(h2) {
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(22px, 3vw, 27px);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #1b1c1a;
    margin: 48px 0 16px;
  }
  .art-body :global(h3) {
    font-family: "Space Grotesk", sans-serif;
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: #1b1c1a;
    margin: 36px 0 12px;
  }
  .art-body :global(ul) {
    list-style: disc;
    margin: 0 0 22px;
    padding-left: 24px;
  }
  .art-body :global(ol) {
    list-style: decimal;
    margin: 0 0 22px;
    padding-left: 24px;
  }
  .art-body :global(li)::marker {
    color: #b9b3a8;
  }
  .art-body :global(li) {
    font-size: 17.5px;
    line-height: 1.7;
    color: #4a4643;
    margin-bottom: 10px;
  }
  .art-body :global(a) {
    color: #1b1c1a;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: #ff7e67;
  }
  .art-body :global(strong) {
    font-weight: 700;
    color: #1b1c1a;
  }
  .art-body :global(blockquote) {
    margin: 30px 0;
    padding: 4px 0 4px 22px;
    border-left: 2px solid #ff7e67;
  }
  .art-body :global(blockquote p) {
    font-size: 18.5px;
    font-style: italic;
    color: #35322d;
    margin-bottom: 10px;
  }
  .art-body :global(code) {
    font-family: "Space Grotesk", monospace;
    font-size: 15px;
    background: #f0eee8;
    border-radius: 5px;
    padding: 2px 6px;
    color: #35322d;
  }
  .art-body :global(pre) {
    background: #1b1c1a;
    border-radius: 12px;
    padding: 20px 22px;
    overflow-x: auto;
    margin: 0 0 24px;
  }
  .art-body :global(pre code) {
    background: none;
    padding: 0;
    font-size: 14.5px;
    line-height: 1.6;
    color: #e8e4dc;
  }
  .art-body :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
    border: 1px solid rgba(27, 28, 26, 0.08);
    margin: 30px 0;
  }
  .art-body :global(hr) {
    border: 0;
    height: 1px;
    background: rgba(27, 28, 26, 0.12);
    margin: 40px 0;
  }
  .art-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 0 0 24px;
    font-size: 16px;
  }
  .art-body :global(th),
  .art-body :global(td) {
    text-align: left;
    padding: 10px 12px;
    border-bottom: 1px solid rgba(27, 28, 26, 0.1);
    color: #4a4643;
  }
  .art-body :global(th) {
    font-family: "Space Grotesk", monospace;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #8f918c;
  }

  /* =================== RENVOI VERS LE PROJET =================== */
  .art-projet {
    display: block;
    margin-top: clamp(44px, 6vw, 60px);
    background: #f4f2ec;
    border: 1px solid rgba(27, 28, 26, 0.09);
    border-radius: 14px;
    padding: 24px 26px;
    text-decoration: none;
    transition: transform 0.2s ease;
  }
  .art-projet:hover {
    transform: translateY(-3px);
  }
  .art-projet-label {
    display: block;
    font-family: "Space Grotesk", monospace;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #9a968f;
  }
  .art-projet-name {
    display: block;
    font-family: "Space Grotesk", sans-serif;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #1b1c1a;
    margin-top: 10px;
  }
  .art-projet-desc {
    display: block;
    font-size: 15.5px;
    line-height: 1.55;
    color: #4a4643;
    margin-top: 8px;
  }

  .art-nl {
    margin-top: clamp(48px, 6vw, 68px);
  }

  /* =================== ARTICLE PRÉCÉDENT / SUIVANT =================== */
  .art-around {
    margin-top: clamp(48px, 6vw, 64px);
    padding-top: 26px;
    border-top: 1px solid rgba(27, 28, 26, 0.1);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
  }
  .art-around-link {
    text-decoration: none;
    display: block;
  }
  .art-around-link--next {
    text-align: right;
  }
  .art-around-cap {
    display: block;
    font-family: "Space Grotesk", monospace;
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #9a968f;
  }
  .art-around-title {
    display: block;
    font-family: "Space Grotesk", sans-serif;
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.015em;
    color: #1b1c1a;
    margin-top: 8px;
    line-height: 1.3;
  }
  .art-around-link:hover .art-around-title {
    color: #ff7e67;
  }

  @media (max-width: 640px) {
    .art-around {
      grid-template-columns: 1fr;
    }
    .art-around-link--next {
      text-align: left;
    }
  }
</style>
