---
import Layout from "../layouts/Layout.astro";

// Page de candidature spontanée. Pas de navigation, un seul parcours.
// Non indexée et absente du plan du site : Fabien en envoie le lien lui-même.
---

<Layout
  title="Fabien Canu · Architecte produit & IA"
  description="Fabien Canu, architecte produit et IA dans le Finistère. Vingt-cinq ans à concevoir et développer des produits numériques."
  robots="noindex, nofollow"
>
<div class="profil">
<nav class="pnav">
  <div class="pnav-inner">
    <a href="/" class="pnav-brand">Fabien Canu</a>
    <div class="pnav-links">
      <a href="/lab" class="pnav-link">Le lab</a>
      <a href="mailto:fabien@koality.fr" class="pnav-cta">Écrire</a>
    </div>
  </div>
</nav>
<main>

  <section class="band hero">
    <div class="inner">
      <div class="hero-grid">
        <div class="hero-main">
          <div class="eyebrow"><span class="eyebrow-dash"></span><span class="eyebrow-txt">Architecte produit &amp; IA · Finistère</span></div>
          <h1>Fabien<br />Canu<span class="accent">.</span></h1>
          <div class="read">
            <p class="lead">Je conçois et développe des produits numériques depuis vingt-cinq ans.</p>
            <p>Aujourd’hui, j’utilise l’IA quand elle apporte réellement quelque chose : explorer plus vite, imaginer de nouvelles interactions, rendre possibles des usages autrefois trop complexes ou trop coûteux.</p>
          </div>
          <div class="btns">
            <a class="btn btn--primary" href="/Fabien-Canu-CV-Architecte-Produit-IA.pdf" target="_blank" rel="noopener">Voir mon CV</a>
            <a class="btn btn--secondary" href="/lab">Découvrir le Lab</a>
          </div>
        </div>

        <div class="method">
          <div class="method-head">
            <div class="kicker"><span class="kicker-dash"></span><span class="kicker-label">Du besoin au produit</span></div>
            <p class="method-lead">Je travaille naturellement entre <b>produit</b>, <b>architecture</b> et <b>développement</b>.</p>
          </div>
          <figure class="flow">
            <svg viewBox="-35 0 630 496" role="img" aria-label="Du besoin au produit : on part d'un besoin et on entre dans le sujet métier, puis on tourne en boucle. On comprend les usages et les contraintes, on imagine plusieurs réponses, on en construit rapidement une première version, puis on se demande si la réponse est juste. Si elle ne l'est pas encore, on recommence à mesure que l'on apprend. Si elle l'est, on obtient un produit adapté à ceux qui vont l'utiliser.">
              <defs>
                <marker id="fa" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0,0 L10,5 L0,10 z" class="f-head"/></marker>
                <marker id="fl" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0,0 L10,5 L0,10 z" class="f-head-loop"/></marker>
              </defs>

              <!-- Étape 0 : le besoin et l'entrée dans le métier -->
              <rect x="155" y="0" width="300" height="58" rx="12" class="f-start"/>
              <text x="305" y="24" class="f-start-t" text-anchor="middle">Partir d’un besoin</text>
              <text x="305" y="45" class="f-start-t" text-anchor="middle">et entrer dans le sujet métier</text>
              <path d="M305,58 V94" class="f-line" marker-end="url(#fa)"/>

              <!-- La boucle, à angles droits, dans le sens des aiguilles d'une montre -->
              <path d="M425,125 H505 V214" class="f-loop" marker-end="url(#fl)"/>
              <path d="M505,272 V365 H429" class="f-loop" marker-end="url(#fl)"/>
              <path d="M185,365 H105 V304" class="f-loop" marker-end="url(#fl)"/>
              <path d="M105,190 V125 H181" class="f-loop" marker-end="url(#fl)"/>

              <rect x="185" y="98" width="240" height="54" rx="8" class="f-box"/>
              <text x="305" y="121" class="f-t" text-anchor="middle">Comprendre les usages</text>
              <text x="305" y="140" class="f-t" text-anchor="middle">et les contraintes</text>

              <rect x="420" y="218" width="170" height="54" rx="8" class="f-box"/>
              <text x="505" y="241" class="f-t" text-anchor="middle">Imaginer plusieurs</text>
              <text x="505" y="260" class="f-t" text-anchor="middle">réponses</text>

              <rect x="185" y="338" width="240" height="54" rx="8" class="f-box"/>
              <text x="305" y="361" class="f-t" text-anchor="middle">En construire rapidement</text>
              <text x="305" y="380" class="f-t" text-anchor="middle">une première version</text>

              <polygon points="105,190 185,245 105,300 25,245" class="f-dia"/>
              <text x="105" y="241" class="f-t f-strong" text-anchor="middle">La réponse</text>
              <text x="105" y="260" class="f-t f-strong" text-anchor="middle">est juste ?</text>

              <text x="305" y="241" class="f-loop-t" text-anchor="middle">On recommence</text>
              <text x="305" y="261" class="f-loop-t" text-anchor="middle">à mesure que l’on apprend</text>
              <text x="96" y="163" class="f-lab f-lab-loop" text-anchor="end">pas encore</text>

              <!-- Sortie -->
              <path d="M25,245 H0 V436" class="f-line" marker-end="url(#fa)"/>
              <text x="10" y="360" class="f-lab">oui</text>
              <rect x="-30" y="440" width="390" height="50" rx="25" class="f-end"/>
              <text x="165" y="470" class="f-end-t" text-anchor="middle">Un produit adapté à ceux qui vont l’utiliser</text>
            </svg>
          </figure>
        </div>
      </div>

      <a class="scroll-cue" href="#projets">Quelques projets <span aria-hidden="true">↓</span></a>
    </div>
  </section>

  <section id="projets" class="band band--low">
    <div class="inner">
      <div class="kicker"><span class="kicker-dash"></span><span class="kicker-label">Exemples</span></div>
      <h2>Quelques projets</h2>
      <p class="intro">Des sujets très différents, mais toujours la même démarche : comprendre ce qu’on cherche réellement à faire, rendre l’idée concrète et voir jusqu’où elle peut aller.</p>

      <div class="projects">
        <article class="project">
          <a class="visual" href="/oignon-roscoff-aop" aria-label="Voir le projet Oignon de Roscoff">
            <img src="/images/oignon-cas-poster.webp" alt="Assistant de saisie des déclarations AOP de l’Oignon de Roscoff" width="1498" height="949" loading="lazy" />
          </a>
          <p class="project-name">Déclarations AOP Oignon de Roscoff</p>
          <h3>Simplifier un métier sans remplacer ses outils</h3>
          <p>Un outil existant qu’il n’était ni nécessaire ni souhaitable de remplacer. Une interface plus naturelle simplifie certaines étapes, et l’utilisateur garde la maîtrise de ce qui engage sa responsabilité.</p>
          <a class="more" href="/oignon-roscoff-aop">→ Voir le projet</a>
        </article>

        <article class="project">
          <a class="visual" href="/lab" aria-label="Voir le Lab">
            <div class="placeholder">Visuel de la carte et de la détection, à fournir</div>
          </a>
          <p class="project-name">Atelier des cartes</p>
          <h3>Retrouver ce qu’une carte ancienne ne dit pas</h3>
          <p>Retrouver des routes, des rivières ou des lieux sur des cartes anciennes, par essais successifs : analyse d’images, données géographiques, IA et interface cartographique.</p>
          <a class="more" href="/lab">→ Explorer le projet</a>
        </article>

        <article class="project">
          <a class="visual" href="/pai" aria-label="Voir l’expérimentation Mémoire et contexte">
            <img src="/images/pai-graph.gif" alt="Le réseau de connaissances qui se construit au fil des sessions" width="1280" height="800" loading="lazy" />
          </a>
          <p class="project-name">Mémoire &amp; contexte</p>
          <h3>Donner une mémoire exploitable à des outils IA</h3>
          <p>Une architecture qui transforme échanges, documents et événements en contexte exploitable par différents agents et outils, pour retrouver ce qui compte au bon moment.</p>
          <a class="more" href="/pai">→ Voir l’expérimentation</a>
        </article>
      </div>

      <a class="lab-link" href="/lab">Découvrir tous les projets du Lab →</a>
    </div>
  </section>

  <section class="band">
    <div class="inner">
      <div class="kicker"><span class="kicker-dash"></span><span class="kicker-label">Communauté</span></div>
      <h2>Partager ce que j’apprends</h2>
      <p class="intro">J’aime montrer ce que j’ai essayé, expliquer comment ça marche et écouter les questions des autres. Je le fais avec des développeurs comme avec des personnes qui découvrent l’IA, dans deux rendez-vous que j’ai lancés dans le Finistère. J’enseigne aussi depuis 2015 à des étudiants, notamment à l’ISEN Brest, à l’UBO et à l’IUT de Lannion.</p>

      <div class="community">
        <article class="community-card">
          <p class="community-tag">Brest · entre techniciens</p>
          <h3>Context Collective</h3>
          <p>J’ai cofondé cette communauté d’ingénierie IA générative à Brest. Son principe est d’apprendre en public : développeurs, ingénieurs, étudiants et freelances montrent ce qu’ils ont testé, y compris ce qui a échoué, et chacun repart avec les essais des autres.</p>
          <p>On se retrouve presque deux fois par mois, en Context Lab à Brest ou en Context Live diffusé sur YouTube. Entre deux rencontres, les échanges continuent tous les jours sur Discord.</p>
          <a class="more" href="https://www.context-collective.org/" target="_blank" rel="noopener">context-collective.org →</a>
        </article>
        <article class="community-card community-card--heart">
          <p class="community-tag">Finistère · pour tout le monde</p>
          <h3>Les Kafé IA</h3>
          <p>C’est le projet qui me tient le plus à cœur. J’ai lancé les Kafé IA pour les personnes qui utilisent peu l’IA et qui se posent de vraies questions. Va-t-elle prendre mon travail&nbsp;? Quel est son impact sur le climat&nbsp;? Va-t-elle bouleverser la concurrence entre entreprises&nbsp;? Fait-elle vraiment gagner en efficacité&nbsp;?</p>
          <p>Chaque session part d’un sujet concret, expliqué sans jargon, puis on en discute ensemble. Les Kafé IA font partie des Cafés IA de France Num, dont la charte interdit toute démarche commerciale. Le but est que chacun reparte capable de décider par lui-même, y compris de ne pas utiliser l’IA.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="band band--dark">
    <div class="inner today">
      <div class="today-text">
        <div class="eyebrow eyebrow--dark"><span class="eyebrow-dash"></span><span class="eyebrow-txt">Aujourd’hui</span></div>
        <div class="read read--dark">
          <p>J’ai envie de mettre cette façon de travailler au service d’une équipe, pour porter des projets IA de la conception à la mise en service et les diffuser en interne.</p>
          <p>Je m’approprie un projet presque comme s’il était le mien, et je prends beaucoup de plaisir à le livrer. J’aime participer aux décisions et j’aime qu’on me contredise, parce qu’un avis contraire améliore souvent le résultat.</p>
        </div>
        <p class="ask">Si mon profil peut servir votre équipe, parlons-en.</p>
        <div class="contact-lines">
          <a class="mail" href="mailto:fabien@koality.fr">fabien@koality.fr</a>
          <a class="tel" href="tel:+33648745829">06 48 74 58 29</a>
        </div>
        <p class="contact-foot">
          <a href="/Fabien-Canu-CV-Architecte-Produit-IA.pdf" target="_blank" rel="noopener">CV</a>
          <a href="https://www.linkedin.com/in/fabien-canu/" target="_blank" rel="noopener">LinkedIn</a>
        </p>
      </div>
      <div class="today-photo">
        <img src="/photo-fabien.jpg" alt="Fabien Canu" width="1300" height="804" loading="lazy" />
      </div>
    </div>
  </section>
</main>
<footer><div class="inner"><a href="/mentions-legales">Mentions légales</a><a href="/confidentialite">Confidentialité</a></div></footer>
</div>
</Layout>

<style>

  .profil {
    --surface: #fbf9f5;
    --low: #f5f3ef;
    --white: #ffffff;
    --ink: #1b1c1a;
    --ink-2: #4a4845;
    --mute: #7d7a74;
    --primary: #006386;
    --coral: #ff7e67;
    --cyan: #00d4ff;
    --amber: #fbbc00;
    --dark-2: #c9c4bb;
    --dark-3: #9a968f;
    --display: "Space Grotesk", "Helvetica Neue", Arial, sans-serif;
    --body: "Manrope", system-ui, -apple-system, "Segoe UI", sans-serif;
  }
  .profil { background: var(--surface); color: var(--ink); font-family: var(--body); font-size: 18px; line-height: 1.65; -webkit-font-smoothing: antialiased; }
  a { color: inherit; }
  img, video { display: block; max-width: 100%; }

  .band { padding-block: clamp(80px, 11vw, 116px); padding-inline: clamp(24px, 8vw, 130px); }
  .band--low { background: var(--low); }
  .band--dark { background: var(--ink); color: var(--surface); }
  .inner { max-width: 1400px; margin: 0 auto; }
  .read { max-width: 660px; }
  .inner.read { max-width: 1400px; }
  .inner.read > * { max-width: 660px; }
  .read p + p { margin-top: 18px; }
  .read p { color: var(--ink-2); }
  .read strong { color: var(--ink); font-weight: 700; }

  h1, h2, h3 { font-family: var(--display); font-weight: 700; letter-spacing: -0.02em; text-wrap: balance; }
  h1 { font-size: clamp(3.2rem, 9vw, 88px); line-height: 0.9; letter-spacing: -0.04em; }
  h2 { font-size: clamp(40px, 6vw, 52px); line-height: 1; letter-spacing: -0.03em; margin-bottom: 28px; }
  h3 { font-size: clamp(22px, 2.4vw, 28px); line-height: 1.2; }


  /* Hero */
  .hero { padding-top: clamp(64px, 10vw, 104px); padding-bottom: clamp(72px, 9vw, 116px); }

  .hero .read { margin-top: 34px; }
  .hero .read p:first-child { font-size: clamp(19px, 1.6vw, 21px); color: var(--ink); }

  .btns { margin-top: 36px; display: flex; flex-wrap: wrap; gap: 12px; }
  .btn { font-family: var(--display); font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; text-decoration: none; padding: 12px 20px; border-radius: 100px; transition: background 0.2s ease; }
  .btn--primary { background: var(--ink); color: var(--surface); }
  .btn--primary:hover { background: #35322d; }
  .btn--secondary { background: #e4e2de; color: var(--ink); }
  .btn--secondary:hover { background: #dad8d3; }
  .btn:focus-visible, .more:focus-visible, .foot-links a:focus-visible { outline: 2px solid var(--coral); outline-offset: 3px; }


  /* Du besoin au produit */
  .hats { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 18px; }
  .hats-lead { font-size: clamp(19px, 1.6vw, 21px); color: var(--ink-2); }
  .hats-list { list-style: none; display: flex; flex-wrap: wrap; gap: 10px; }
  .hat { font-family: var(--display); font-weight: 700; font-size: clamp(18px, 1.8vw, 22px); padding: 8px 16px; border-radius: 0.375rem; background: var(--white); }
  .hat--cyan { --c: var(--cyan); }
  .hat--coral { --c: var(--coral); }
  .hat--amber { --c: var(--amber); }

  .path { list-style: none; margin-top: 56px; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 12px; position: relative; }
  .path::before { content: ""; position: absolute; top: 19px; left: 20px; right: 18%; height: 2px; background: repeating-linear-gradient(90deg, var(--mute) 0 6px, transparent 6px 12px); opacity: 0.35; }
  .path li { position: relative; display: flex; flex-direction: column; gap: 14px; font-size: 16px; line-height: 1.4; color: var(--ink); font-weight: 600; min-width: 0; }
  .path-n { width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; background: var(--white); font-family: var(--display); font-weight: 700; font-size: 16px; color: var(--primary); box-shadow: 0 0 0 4px var(--low); }
  .path-loop .path-n { background: var(--primary); color: var(--white); font-size: 20px; }

  .ai { margin-top: 36px; }
  .ai-lead { max-width: 660px; color: var(--ink-2); }
  .ai-cards { list-style: none; margin-top: 20px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }
  .ai-cards li { background: var(--white); border-radius: 10px; padding: 22px 22px 24px; font-size: 17px; line-height: 1.45; color: var(--ink-2); }
  .ai-k { display: block; font-family: var(--display); font-weight: 700; font-size: 21px; color: var(--ink); margin-bottom: 4px; }

  .punch { margin-top: 64px; max-width: 820px; font-family: var(--display); font-weight: 700; font-size: clamp(24px, 3vw, 34px); line-height: 1.2; letter-spacing: -0.02em; color: var(--ink); text-wrap: balance; }
  .punch span { display: block; color: var(--mute); }


  /* Logigramme */
  .flow { min-width: 0; margin: 0; }
  .flow svg { width: 100%; max-width: 580px; height: auto; display: block; margin-inline: auto; }
  .f-box { fill: var(--white); stroke: rgba(27, 28, 26, 0.12); stroke-width: 1; }
  .f-t { font-family: var(--body); font-size: 16px; font-weight: 600; fill: var(--ink); }
  .f-strong { font-family: var(--display); font-weight: 700; }
  .f-start { fill: var(--ink); }
  .f-start-t { font-family: var(--display); font-weight: 700; font-size: 16px; fill: var(--surface); }
  .f-end { fill: var(--primary); }
  .f-end-t { font-family: var(--display); font-weight: 700; font-size: 16px; fill: var(--white); }
  .f-dia { fill: #ffdfa0; }
  /* Toutes les flèches ont le même trait et la même pointe, seule la couleur distingue la boucle */
  .f-line, .f-loop { stroke-width: 2; fill: none; }
  .f-line { stroke: var(--ink); }
  .f-loop { stroke: var(--coral); }
  .f-head { fill: var(--ink); }
  .f-head-loop { fill: var(--coral); }
  .f-lab { font-family: var(--display); font-weight: 700; font-size: 15px; fill: var(--ink); }
  .f-lab-loop { fill: #d6533b; }
  .f-loop-t { font-family: var(--body); font-weight: 500; font-size: 15px; fill: var(--ink-2); }

  /* Projets */
  .intro { max-width: 660px; color: var(--ink-2); }
  .projects { margin-top: 56px; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(20px, 2.6vw, 32px); }
  .project { display: flex; flex-direction: column; min-width: 0; }
  .project-name { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.14em; color: var(--mute); margin: 20px 0 8px; }
  .project h3 { font-size: clamp(20px, 1.8vw, 24px); }
  .project p:not(.project-name) { margin-top: 10px; font-size: 16px; line-height: 1.55; color: var(--ink-2); }
  .more { display: inline-block; margin-top: auto; padding-top: 18px; font-family: var(--display); font-weight: 600; font-size: 16px; color: var(--primary); text-decoration: none; border-bottom: 2px solid transparent; align-self: flex-start; }
  .more:hover { border-bottom-color: var(--primary); }
  .visual { display: block; border-radius: 10px; overflow: hidden; background: var(--white); box-shadow: 0 12px 32px rgba(42, 42, 42, 0.06); min-width: 0; }
  .visual img { width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; }
  .placeholder { aspect-ratio: 16 / 10; display: grid; place-items: center; text-align: center; padding: 24px; font-size: 15px; color: var(--mute); background: repeating-linear-gradient(135deg, var(--white) 0 14px, var(--low) 14px 28px); }
  .lab-link { display: inline-block; margin-top: 48px; font-family: var(--display); font-weight: 600; font-size: 17px; color: var(--primary); text-decoration: none; border-bottom: 2px solid transparent; }
  .lab-link:hover { border-bottom-color: var(--primary); }

  /* Communauté */
  .community { margin-top: 48px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(20px, 2.6vw, 32px); }
  .community-card { background: var(--low); border-radius: 14px; padding: clamp(26px, 3vw, 40px); }
  .community-card--heart { background: #fff0ed; }
  .community-card p { margin-top: 14px; color: var(--ink-2); font-size: 17px; line-height: 1.6; }
  .community-card { display: flex; flex-direction: column; }
  .community-card h3 { margin-bottom: 4px; }
  .community-tag { margin: 0 0 10px !important; font-family: var(--display); font-size: 12px !important; letter-spacing: 0.14em; text-transform: uppercase; color: var(--mute) !important; }
  .community-card--heart .community-tag { color: #d6533b !important; }

  /* Aujourd'hui */
  .band--dark h2 { color: var(--surface); }
  .band--dark .read p { color: var(--dark-2); }
  .band--dark .read strong { color: var(--surface); }
  .ask { margin-top: 44px; font-family: var(--display); font-weight: 600; font-size: clamp(32px, 5vw, 40px); line-height: 1.1; letter-spacing: -0.02em; color: var(--surface); max-width: 640px; }
  footer { background: var(--ink); color: #7a756c; font-size: 12px; padding-inline: clamp(20px, 8vw, 130px); padding-block: 0 28px; }
  footer .inner { padding-top: 18px; box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08); }
  footer a { color: var(--dark-3); text-decoration: none; margin-right: 14px; }

  @media (max-width: 860px) {
    .band { padding-block: 64px; }
    .hero .inner { padding-left: 0; }
    .projects, .community { grid-template-columns: 1fr; }
    .projects { gap: 44px; }
    .path { grid-template-columns: 1fr; gap: 18px; }
    .path::before { top: 20px; bottom: 20px; left: 19px; right: auto; width: 2px; height: auto; background: repeating-linear-gradient(180deg, var(--mute) 0 6px, transparent 6px 12px); }
    .path li { flex-direction: row; align-items: center; }
    .path-n { flex: none; }
    .ai-cards { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .profil { font-size: 17px; }
    .btn { flex: 1 1 auto; text-align: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; }
  }

  /* Alignement sur la page d'accueil */
  .pnav { position: sticky; top: 0; z-index: 50; background: rgba(251, 249, 245, 0.82); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border-bottom: 1px solid rgba(27, 28, 26, 0.07); padding: 0 clamp(24px, 8vw, 130px); }
  .pnav-inner { max-width: 1400px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; padding: 18px 0; }
