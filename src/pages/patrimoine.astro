---
import Layout from "../layouts/Layout.astro";

// Page envoyée aux musées, services d'archives, lieux de patrimoine, offices de tourisme
// et scénographes, depuis les messages LinkedIn de la campagne patrimoine (novembre 2026).
// Fabien s'y présente en son nom, comme sur /formateur. Les réalisations clientes sont
// celles de Jeofun, l'activité de Koality pour le tourisme et le patrimoine : la page le dit
// en bas, donne l'adresse Koality et renvoie vers jeofun.fr.
// Non indexée et absente du plan du site : Fabien en envoie le lien lui-même.
// Inventaire des réalisations et de leurs sources :
// ___FAB/linkedin/prospection/inventaire-realisations-patrimoine.md

const gameUrl = "https://cassini-game.jeofun.fr";

// Ce que Fabien fabrique pour un musée, un lieu ou un territoire.
const formats = [
  { icon: "casino", title: "Des jeux sur carte ancienne", text: "Un jeu court, aux règles tenues en une phrase, posé sur la carte ancienne de votre territoire. Il se joue à deux sur une table tactile, sur une borne ou chez soi." },
  { icon: "auto_stories", title: "Des récits sur carte", text: "Le visiteur lit une histoire et la carte avance avec le texte. Les lieux, les dates et les documents d’archives apparaissent quand le récit en parle." },
  { icon: "tour", title: "Des applications de visite", text: "Un parcours dans une exposition ou dans une ville, avec un mode famille, un mode défi pour les groupes et un mode pour aller plus loin." },
  { icon: "map", title: "Des cartes gravées", text: "Une carte de votre territoire dessinée dans le style de Cassini, de l’état-major ou des années 1930, à partir des données d’aujourd’hui. Elle s’imprime en grand format." },
];

interface Work {
  // « Pour un client » ou « Projet personnel », avec la date.
  tag: string;
  title: string;
  text: string;
  link?: { href: string; label: string };
  // fit « contain » montre l'image entière sur le fond indiqué (maquettes de tablettes ou de bornes).
  image?: { src: string; alt: string; width: number; height: number; fit?: "cover" | "contain"; bg?: string };
}

const works: Work[] = [
  {
    tag: "Département du Morbihan",
    title: "Portraits de Châteaux",
    text: "L’application de l’exposition sur onze châteaux du Morbihan. Elle propose trois modes de visite : une quête en famille, un défi chronométré sur tablettes pour les groupes et les scolaires, et un mode Histoire avec des vidéos et des documents absents des cartels.",
    link: { href: "https://jeofun.fr/compagnon-de-visite/", label: "Voir le projet" },
    image: { src: "/images/patrimoine-portraits-chateaux.webp", alt: "L’application Portraits de Châteaux sur trois tablettes de l’exposition", width: 1400, height: 788 },
  },
  {
    tag: "Lesneven et le Musée du Léon · nouvelle version en juillet 2026",
    title: "Joue avec Léon",
    text: "Un jeu de piste dans Lesneven, pour les familles et les scolaires. Un guide virtuel fait découvrir la ville et sa devise, étape par étape. La version de 2026 ajoute une carte interactive avec la position du joueur.",
    link: { href: "https://leon.lesneven.bzh", label: "Ouvrir le jeu" },
    image: { src: "/images/patrimoine-leon.webp", alt: "Le jeu Joue avec Léon sur trois téléphones : le plan de Lesneven, l’accueil du guide Léon et une question", width: 1366, height: 768 },
  },
  {
    tag: "Archives départementales du Finistère",
    title: "La Grande Guerre en Finistère",
    text: "Le quiz d’une exposition itinérante destinée aux collèges et aux lycées. Le quiz existait sur papier. Sa version numérique reprend le contenu de l’exposition, sans nouvelle production de textes.",
    link: { href: "https://jeofun.fr/du-papier-au-numerique/", label: "Voir le projet" },
    image: { src: "/images/patrimoine-grande-guerre.webp", alt: "Le quiz La Grande Guerre en Finistère sur une tablette, devant l’écran d’accueil", width: 1400, height: 800 },
  },
  {
    tag: "Récit pour une borne de musée",
    title: "La bataille de Brest",
    text: "Le récit de 1944 sur une carte animée, des plages de Normandie jusqu’à Brest, avec des photos d’archives. Il est pensé pour une borne dans un musée et se consulte aussi en ligne.",
    link: { href: "https://brest44.jeofun.fr", label: "Ouvrir le récit" },
    image: { src: "/images/patrimoine-bataille-brest.webp", alt: "La bataille de Brest sur une borne tactile : la carte de la Bretagne et le texte du récit avec une photo d’archives", width: 1400, height: 592 },
  },
  {
    tag: "Projet personnel · été 2026",
    title: "L’encre des vents",
    text: "Un outil qui grave des cartes dans quatre styles anciens à partir des données de l’IGN et d’OpenStreetMap. Il a servi à des affiches sur les noms de lieux bretons, comme « Les Ker du Nord-Finistère », exposées à Lesneven en août 2026.",
    link: { href: "https://encre-des-vents.fr", label: "Voir les cartes" },
    image: { src: "/images/atelier-des-cartes-affiche.webp", alt: "Affiche « Les Ker du Nord-Finistère », gravée dans le style de Cassini", width: 1600, height: 1280, fit: "contain", bg: "#ece9e2" },
  },
  {
    tag: "Projet personnel · septembre 2026",
    title: "Le château de Carman",
    text: "Une enquête sur un château disparu de Kernilis. Les textes de Cambry et de Fréminville, le cadastre de 1830 calé sur la carte et le relief LiDAR de l’IGN ont été croisés. Les parcelles nommées « Castel » dans le cadastre de 1831 ont confirmé l’emplacement. Le château a ensuite été restitué en 3D.",
    image: { src: "/images/patrimoine-carman.webp", alt: "Restitution 3D du château de Carman sur son promontoire, au-dessus du moulin", width: 1600, height: 900 },
  },
];

// Les quatre étapes du travail, dessinées comme le réseau de triangles de Cassini.
// Chaque étape ferme un triangle autour du point central (center).
const steps = [
  { n: 1, title: "Vos contenus", text: "Je pars de vos textes d’exposition, de vos documents d’archives, de vos cartes et de vos photos. Un jeu ou un récit peut souvent se construire sans écrire de nouveaux textes." },
  { n: 2, title: "La fabrication", text: "Je conçois et je développe chaque projet moi-même. Je choisis le sujet, j’écris le récit, je fixe les règles du jeu et je juge le rendu." },
  { n: 3, title: "Les sources", text: "Je vérifie chaque fait historique dans les sources, et les sources sont citées dans le projet." },
  { n: 4, title: "Le premier essai", text: "Je montre une première version jouable très tôt. Vous la testez avec votre équipe ou votre public, et on la corrige selon leurs retours." },
];
const center = { x: 318, y: 292 };
const stations = [
  { x: 92, y: 404, label: "Vos contenus", anchor: "start", dx: -6, dy: 34 },
  { x: 214, y: 126, label: "La fabrication", anchor: "start", dx: -14, dy: -22 },
  { x: 498, y: 96, label: "Les sources", anchor: "end", dx: 14, dy: -22 },
  { x: 528, y: 410, label: "Le premier essai", anchor: "end", dx: 8, dy: 34 },
];
// Ordre de tracé : chaque groupe de traits ferme le triangle de l'étape, qui se colore ensuite.
const edges = [
  [stations[0], stations[1]], [stations[1], center], [center, stations[0]],
  [stations[1], stations[2]], [stations[2], center],
  [stations[2], stations[3]], [stations[3], center],
  [stations[3], stations[0]],
];
const triangles = [
  { points: [stations[0], stations[1], center], tint: "coral", after: 3 },
  { points: [stations[1], stations[2], center], tint: "cyan", after: 5 },
  { points: [stations[2], stations[3], center], tint: "amber", after: 7 },
  { points: [stations[3], stations[0], center], tint: "coral", after: 8 },
];
const pts = (list: { x: number; y: number }[]) => list.map((p) => `${p.x},${p.y}`).join(" ");

const sections = [
  { id: "cassini", label: "Le jeu Cassini" },
  { id: "fabrique", label: "Types de projets" },
  { id: "realisations", label: "Réalisations" },
  { id: "methode", label: "Ma façon de travailler" },
  { id: "contact", label: "Contact" },
];

const contactMail = "fabien@koality.fr";
const contactHref = `mailto:${contactMail}?subject=` + encodeURIComponent("Un sujet à faire découvrir");
---

<Layout
  title="Jeux, récits et cartes pour le patrimoine · Fabien Canu"
  description="Fabien Canu conçoit des jeux sur carte ancienne, des récits sur carte et des applications de visite pour les musées, les archives, les lieux de patrimoine et les offices de tourisme. Basé dans le Finistère."
  image="/images/og-patrimoine.jpg"
  imageAlt="Le jeu Cassini : des triangles tracés entre les clochers sur la carte de la région de Brest"
  siteName="Fabien Canu"
  robots="noindex, nofollow"
>
<div class="profil">

<nav class="pnav">
  <div class="pnav-inner">
    <a href="/" class="pnav-brand">Fabien Canu</a>
    <div class="pnav-links">
      <a href="/lab" class="pnav-link">Le lab</a>
      <a href={contactHref} class="pnav-cta">Écrire</a>
    </div>
  </div>
</nav>

<main>

  <section class="band hero">
    <div class="hero-map" aria-hidden="true"></div>
    <div class="inner">
      <div class="hero-grid">
        <div class="hero-main">
          <h1>Fabien<br />Canu<span class="accent">.</span></h1>
          <p class="role">Jeux, récits et cartes pour le patrimoine</p>
          <div class="read">
            <p class="lead">Je conçois des jeux, des récits sur carte et des applications de visite pour les musées, les services d’archives, les lieux de patrimoine et les offices de tourisme.</p>
            <p>Je travaille dans le numérique depuis vingt-cinq ans, dans le design, le développement et la maîtrise d’œuvre de projets. L’IA fait partie de mes outils depuis deux ans. Elle rend un projet sur mesure accessible au budget d’un musée de taille modeste, d’un service d’archives ou d’un office de tourisme.</p>
          </div>
        </div>

        <div class="offer grain-paper">
          <ul class="terms">
            <li>Basé dans le Finistère</li>
            <li>Un jeu, un récit, une borne ou une application de visite</li>
            <li>À partir de vos fonds, de votre exposition ou de votre lieu</li>
          </ul>
          <div class="btns">
            <a class="btn btn--primary" href={contactHref}>Me donner votre sujet</a>
            <a class="btn btn--secondary" href={gameUrl} target="_blank" rel="noopener">Jouer à Cassini</a>
          </div>
          <p class="next">Dites-moi le sujet, le lieu et le public visé. Je vous réponds avec une première idée de ce qu’on peut en faire.</p>
        </div>
      </div>

      <nav class="jump" aria-label="Sur cette page">
        <p class="jump-label">Sur cette page</p>
        <ul>
          {sections.map((section) => (
            <li><a href={`#${section.id}`}>{section.label}<span aria-hidden="true">↓</span></a></li>
          ))}
        </ul>
      </nav>
    </div>
  </section>

  <section id="cassini" class="band band--low">
    <div class="inner split">
      <div class="split-text">
        <div class="kicker"><span class="kicker-dash"></span><span class="kicker-label">Un exemple</span></div>
        <h2>De l’exposition au jeu</h2>
        <div class="read">
          <p class="lead">Les Archives nationales présentent « La carte de France de Cassini » à l’hôtel de Soubise, jusqu’au 1er février 2027. J’en suis sorti avec l’envie d’en faire un jeu.</p>
          <p>Au XVIIIe siècle, les ingénieurs du roi montaient dans les clochers pour mesurer la France en triangles. Dans le jeu, deux ingénieurs s’affrontent sur une feuille de la carte autour de Brest. Chacun trace une ligne entre deux clochers à son tour, et le joueur qui ferme un triangle le remporte. Des événements tirés de faits réels ponctuent la partie.</p>
          <p>Le jeu se joue gratuitement, sans compte, à partir de 12 ans. La carte vient de l’IGN et de la BnF.</p>
        </div>
        <div class="btns">
          <a class="btn btn--primary" href={gameUrl} target="_blank" rel="noopener">Jouer à Cassini</a>
        </div>
      </div>
      <a class="split-visual" href={gameUrl} target="_blank" rel="noopener" aria-label="Jouer à Cassini">
        <img src="/images/patrimoine-cassini.webp" alt="Le jeu Cassini : la carte de la région de Brest, les clochers reliés par des lignes et les points de chaque triangle" width="1586" height="958" loading="lazy" />
      </a>
    </div>
  </section>

  <section id="fabrique" class="band">
    <div class="inner">
      <div class="kicker"><span class="kicker-dash"></span><span class="kicker-label">Pour votre lieu</span></div>
      <h2>Jeux, récits, visites et cartes</h2>
      <p class="intro">Chaque projet part de votre sujet : une collection, une exposition, un fonds d’archives, une ville ou un sentier. La carte, ancienne ou actuelle, sert souvent de fil.</p>
      <ol class="formats">
        {formats.map((format) => (
          <li>
            <span class="material-symbols-outlined format-icon" aria-hidden="true">{format.icon}</span>
            <h3>{format.title}</h3>
            <p>{format.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="realisations" class="band band--low">
    <div class="inner">
      <div class="kicker"><span class="kicker-dash"></span><span class="kicker-label">Références</span></div>
      <h2>Des réalisations, pour des clients et pour moi</h2>
      <div class="works">
        {works.map((work) => (
          <article class="work grain-paper">
            {work.image && (
              <div class:list={["work-visual", work.image.fit === "contain" && "work-visual--contain"]} style={work.image.bg ? `background: ${work.image.bg}` : undefined}>
                <img src={work.image.src} alt={work.image.alt} width={work.image.width} height={work.image.height} loading="lazy" />
              </div>
            )}
            <p class="work-tag">{work.tag}</p>
            <h3>{work.title}</h3>
            <p class="work-text">{work.text}</p>
            {work.link && <a class="more" href={work.link.href} target="_blank" rel="noopener">{work.link.label} →</a>}
          </article>
        ))}
      </div>

      <div class="more-works grain-paper">
        <div class="more-works-text">
          <h3>D’autres réalisations sur jeofun.fr</h3>
          <p>Jeofun est l’activité de Koality pour le tourisme et le patrimoine. Le site présente les applications de visite, les jeux de piste et les bornes réalisés pour Quimper, Lesneven, Lanildut, Brest Métropole et les départements du Finistère et du Morbihan.</p>
        </div>
        <a class="btn btn--primary" href="https://jeofun.fr/" target="_blank" rel="noopener">Voir jeofun.fr</a>
      </div>
    </div>
  </section>

  <section id="methode" class="band">
    <div class="inner method">
      <div class="method-text">
        <div class="kicker"><span class="kicker-dash"></span><span class="kicker-label">Méthode</span></div>
        <h2>Ma façon de travailler</h2>
        <ol class="method-steps">
          {steps.map((step) => (
            <li>
              <span class="method-n" aria-hidden="true">{step.n}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <figure class="method-figure">
        <svg class="method-net" viewBox="0 0 620 500" role="img" aria-labelledby="method-net-title">
          <title id="method-net-title">Les quatre étapes du travail, reliées en triangles comme sur la carte de Cassini</title>
          <defs>
            <clipPath id="method-clip"><rect x="0" y="0" width="620" height="500" rx="20" /></clipPath>
          </defs>
          <g clip-path="url(#method-clip)">
            <rect x="0" y="0" width="620" height="500" class="net-paper" />
            <image href="/images/patrimoine-cassini-filigrane.jpg" x="-260" y="-150" width="1100" height="770" preserveAspectRatio="xMidYMid slice" class="net-map" />
          </g>
          {triangles.map((tri, i) => (
            <polygon points={pts(tri.points)} class={`net-tri net-tri--${tri.tint}`} style={`--d: ${tri.after * 0.35 + 0.1}s`} />
          ))}
          {edges.map(([a, b], i) => (
            <line x1={a.x} y1={a.y} x2={b.x} y2={b.y} pathLength="1" class="net-line" style={`--d: ${i * 0.35}s`} />
          ))}
          <g class="net-center">
            <circle cx={center.x} cy={center.y} r="6" />
          </g>
          {stations.map((s, i) => (
            <g class="net-station" style={`--d: ${i * 0.7}s`}>
              <circle cx={s.x} cy={s.y} r="13" class="net-ring" />
              <circle cx={s.x} cy={s.y} r="4.5" class="net-dot" />
              <text x={s.x + s.dx} y={s.y + s.dy} text-anchor={s.anchor} class="net-label"><tspan class="net-label-n">{i + 1}</tspan> {s.label}</text>
            </g>
          ))}
        </svg>
        <figcaption>Les quatre étapes reliées en triangles, sur la carte de Cassini autour de Brest. Carte : IGN et BnF.</figcaption>
      </figure>
    </div>
  </section>

  <section id="contact" class="band band--dark">
    <div class="inner contact">
      <div class="eyebrow eyebrow--dark"><span class="eyebrow-dash"></span><span class="eyebrow-txt">Travailler ensemble</span></div>
      <h2 class="ask">Vous avez un sujet à faire découvrir&nbsp;?</h2>
      <div class="read read--dark">
        <p>Envoyez-moi le sujet, le lieu et le public visé : une exposition à venir, un fonds d’archives, une collection, une ville. Je vous réponds avec une première idée de ce qu’on peut en faire.</p>
      </div>
      <div class="btns">
        <a class="btn btn--light" href={contactHref}>Me donner votre sujet</a>
      </div>
      <div class="contact-lines">
        <a class="mail" href={contactHref}>{contactMail}</a>
        <a class="tel" href="tel:+33648745829">06 48 74 58 29</a>
      </div>
      <p class="contact-foot">
        <a href="/lab">Mes projets</a>
        <a href="https://www.linkedin.com/in/fabien-canu/" target="_blank" rel="noopener">LinkedIn</a>
      </p>
      <div class="studio">
        <h3>Jeofun, chez Koality</h3>
        <p>Mes réalisations pour les musées et les collectivités passent par Jeofun, l’activité de Koality consacrée au tourisme et au patrimoine. Je suis cogérant de Koality.</p>
        <a class="studio-link" href="https://jeofun.fr/" target="_blank" rel="noopener">jeofun.fr →</a>
      </div>
    </div>
  </section>

</main>

<footer><div class="inner"><a href="/mentions-legales">Mentions légales</a><a href="/confidentialite">Confidentialité</a></div></footer>

</div>
  <!-- Suivi Matomo de la page : un événement par action utile à mesurer.
       Dans Matomo, ils apparaissent dans Comportement > Événements, catégorie « Patrimoine ». -->
  <script is:inline>
    (function () {
      // Matomo remplace window._paq une fois chargé : on le relit à chaque envoi
      var send = function (name) { (window._paq = window._paq || []).push(["trackEvent", "Patrimoine", name]); };

      // Clics sur les liens : mail, téléphone, jeu Cassini, réalisations, Jeofun
      document.addEventListener("click", function (event) {
        var link = event.target.closest && event.target.closest("a[href]");
        if (!link) return;
        var href = link.getAttribute("href");
        if (href.indexOf("mailto:") === 0) send("Clic mail");
        else if (href.indexOf("tel:") === 0) send("Clic téléphone");
        else if (href.indexOf("cassini-game.jeofun.fr") !== -1) send("Clic jeu Cassini");
        else if (href === "https://jeofun.fr/") send("Clic Jeofun");
        else if (link.closest(".work")) send("Clic réalisation : " + link.closest(".work").querySelector("h3").textContent);
      });

      // Le schéma de la méthode se dessine quand il arrive à l'écran.
      // Sans script, ou avec les animations réduites, il s'affiche déjà dessiné.
      var net = document.querySelector(".method-net");
      var reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (net && !reduce && "IntersectionObserver" in window) {
        net.classList.add("is-waiting");
        var netObserver = new IntersectionObserver(function (entries) {
          if (entries[0].isIntersecting) { net.classList.remove("is-waiting"); netObserver.disconnect(); }
        }, { threshold: 0.35 });
        netObserver.observe(net);
      }

      // Arrivée en bas de page, sur le bloc de contact
      var contact = document.getElementById("contact");
      if (contact && "IntersectionObserver" in window) {
        var observer = new IntersectionObserver(function (entries) {
          if (entries[0].isIntersecting) { send("Arrivée en bas de page"); observer.disconnect(); }
        }, { threshold: 0.4 });
        observer.observe(contact);
      }
    })();
  </script>
</Layout>

<style>
  /* Mêmes couleurs, polices et blocs que les pages /profil et /formateur */
  .profil {
    --surface: #fbf9f5;
    --low: #f5f3ef;
    --white: #ffffff;
    --ink: #1b1c1a;
    --ink-2: #4a4845;
    --mute: #7d7a74;
    /* Gris des petites étiquettes, assez foncé pour rester lisible sur fond clair */
    --label: #65625c;
    --primary: #006386;
    --coral: #ff7e67;
    --dark-2: #c9c4bb;
    --dark-3: #9a968f;
    --display: "Space Grotesk", "Helvetica Neue", Arial, sans-serif;
    --body: "Manrope", system-ui, -apple-system, "Segoe UI", sans-serif;
  }
  .profil { background: var(--surface); color: var(--ink); font-family: var(--body); font-size: 18px; line-height: 1.65; -webkit-font-smoothing: antialiased; }
  a { color: inherit; }
  img { display: block; max-width: 100%; }

  .band { padding-block: clamp(80px, 11vw, 116px); padding-inline: clamp(24px, 8vw, 130px); }
  .band--low { background: var(--low); }
  .band--dark { background: var(--ink); color: var(--surface); }
  .inner { max-width: 1400px; margin: 0 auto; }
  .read { max-width: 660px; }
  .read p + p { margin-top: 18px; }
  .read p { color: var(--ink-2); }

  h1, h2, h3 { font-family: var(--display); font-weight: 700; letter-spacing: -0.02em; text-wrap: balance; }
  h1 { font-size: clamp(3.2rem, 9vw, 88px); line-height: 0.9; letter-spacing: -0.04em; }
  h2 { font-size: clamp(34px, 5vw, 48px); line-height: 1.04; letter-spacing: -0.03em; margin-bottom: 28px; max-width: 900px; }
  h3 { font-size: clamp(20px, 1.8vw, 24px); line-height: 1.2; }

  /* Premier écran : métier, modalités, suite donnée au contact */
  .hero { position: relative; overflow: hidden; padding-top: clamp(56px, 7vw, 88px); padding-bottom: clamp(64px, 8vw, 104px); }
  .hero > .inner { position: relative; z-index: 1; }
  /* Filigrane : une carte gravée par L'encre des vents (Porsmoguer, Plouarzel), en bleu, fondue vers la gauche */
