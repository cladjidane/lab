---
import Layout from "./Layout.astro";

interface Props {
  title: string;
  description?: string;
  updated?: string;
}

const { title, description, updated } = Astro.props;
---

<Layout title={`${title} · Fabien Canu`} description={description}>
  <nav class="legal-nav">
    <div class="legal-nav-inner">
      <a href="/" class="legal-brand">Fabien Canu</a>
      <div class="legal-nav-links">
        <a href="/#a-propos" class="legal-nav-link">À propos</a>
        <a href="/journal" class="legal-nav-link">Journal</a>
        <a href="/lab" class="legal-nav-link">Le lab</a>
        <a href="mailto:fabien@koality.fr" class="legal-nav-cta">Écrire</a>
      </div>
    </div>
  </nav>

  <main class="legal">
    <div class="legal-col">
      <a href="/" class="legal-back">← Retour à l'accueil</a>
      <h1 class="legal-h1">{title}</h1>
      {updated && <p class="legal-updated">Dernière mise à jour : {updated}</p>}
      <div class="legal-body">
        <slot />
      </div>
      <div class="legal-links">
        <a href="/mentions-legales">Mentions légales</a>
        <span class="sep">·</span>
        <a href="/confidentialite">Politique de confidentialité</a>
        <span class="sep">·</span>
        <a href="/cookies">Cookies</a>
      </div>
    </div>
  </main>
</Layout>

<style>
  .legal-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(251, 249, 245, 0.82);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(27, 28, 26, 0.07);
    padding: 0 clamp(24px, 8vw, 130px);
  }
  .legal-nav-inner {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 0;
  }
  .legal-brand {
    font-family: "Space Grotesk", sans-serif;
    font-weight: 700;
    font-size: 16px;
    color: #1b1c1a;
    letter-spacing: -0.01em;
    text-decoration: none;
  }
  .legal-nav-links {
    display: flex;
    align-items: center;
    gap: 26px;
  }
  .legal-nav-link {
    font-family: "Space Grotesk", monospace;
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #6e7880;
    text-decoration: none;
  }
  .legal-nav-link:hover {
    color: #ff7e67;
  }
  .legal-nav-cta {
    font-family: "Space Grotesk", monospace;
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fbf9f5;
    background: #1b1c1a;
    padding: 9px 16px;
    border-radius: 100px;
    text-decoration: none;
  }

  .legal {
    background: #fbf9f5;
    min-height: 70vh;
  }
  .legal-col {
    max-width: 760px;
    margin: 0 auto;
    padding: clamp(48px, 7vw, 88px) clamp(24px, 5vw, 40px) clamp(72px, 9vw, 112px);
  }
  .legal-back {
    font-family: "Space Grotesk", monospace;
    font-size: 12px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #8f918c;
    text-decoration: none;
  }
  .legal-back:hover {
    color: #ff7e67;
  }
  .legal-h1 {
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(34px, 6vw, 48px);
    line-height: 1.05;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: #1b1c1a;
    margin: 22px 0 0;
  }
  .legal-updated {
    font-family: "Space Grotesk", monospace;
    font-size: 12px;
    letter-spacing: 0.06em;
    color: #9a968f;
    margin-top: 14px;
  }
  .legal-body {
    margin-top: 40px;
  }
  .legal-body :global(h2) {
    font-family: "Space Grotesk", sans-serif;
    font-size: clamp(20px, 2.6vw, 24px);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #1b1c1a;
    margin: 44px 0 14px;
  }
  .legal-body :global(p),
  .legal-body :global(li) {
    font-size: 16.5px;
    line-height: 1.65;
    color: #4a4643;
  }
  .legal-body :global(p) {
    margin: 0 0 16px;
  }
  .legal-body :global(ul) {
    margin: 0 0 16px;
    padding-left: 22px;
  }
  .legal-body :global(li) {
    margin-bottom: 8px;
  }
  .legal-body :global(a) {
    color: #1b1c1a;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: #ff7e67;
  }
  .legal-body :global(.todo) {
    background: #fff0ed;
    border: 1px dashed #e0563c;
    border-radius: 6px;
    padding: 1px 7px;
    font-family: "Space Grotesk", monospace;
    font-size: 13px;
    color: #c2452d;
    white-space: nowrap;
  }
  .legal-links {
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid rgba(27, 28, 26, 0.1);
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
    font-family: "Space Grotesk", monospace;
    font-size: 12px;
    color: #9a968f;
  }
  .legal-links a {
    color: #6e7880;
    text-decoration: none;
  }
  .legal-links a:hover {
    color: #ff7e67;
  }
  .legal-links .sep {
    color: #d3ccc0;
  }
</style>
