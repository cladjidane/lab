# Envoi du mail d'inscription à la newsletter (/api/newsletter).
# À renseigner dans Vercel : Settings > Environment Variables.
# En local, copier ce fichier en .env.local et remplir SMTP_PASS.
# Sans ces variables, l'inscription répond une erreur en ligne, et fonctionne
# à vide en local (l'adresse est simplement affichée dans le terminal).

# Boîtes @koality.fr : serveur mutualisé OVH, port 465 en SSL.
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_USER=fabien@koality.fr
SMTP_PASS=

# Expéditeur du mail. Par défaut, SMTP_USER.
# Ne jamais y mettre un nom devant l'adresse : relayé depuis Vercel, OVH jette
# en silence les messages dont le From ne correspond pas au compte authentifié.
NEWSLETTER_FROM=

# Destinataire du mail. Par défaut, fabien@koality.fr.
NEWSLETTER_TO=fabien@koality.fr
